---
/**
 * Taskbar Win2000 abajo, en todos los tamaños: Inicio, botón de la
 * ventana abierta (restaura si está minimizada) y bandeja con idioma
 * y reloj. En móvil es la misma barra, con targets algo mayores.
 */
import { getCollection } from 'astro:content';
import OSIcon from './OSIcon.astro';
import { CATEGORIAS } from '../../os/categorias';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl, switchLocalePath, projectsFor } from '../../i18n/utils';
import type { OSWindowInfo } from '../../os/types';

interface Props {
  lang: Lang;
  /** Ventana abierta en esta ruta (botón "pulsado" en la taskbar). */
  window?: OSWindowInfo;
}
const { lang, window: win } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

// Carpetas con contenido, para el menú Inicio.
const all = projectsFor(await getCollection('proyectos'), lang);
const carpetas = CATEGORIAS.filter((c) => all.some((p) => p.entry.data.categoria === c.slug));
---

<nav class="taskbar" aria-label={t('os.barra')}>
  <details class="start" data-start>
    <summary class="w2k-btn start-btn">
      <OSIcon name="windows" size={18} />
      <span>{t('os.inicio')}</span>
    </summary>
    <div class="start-menu">
      <span class="sm-banner" aria-hidden="true">Masides<b>2000</b></span>
      <ul class="sm-list" role="list">
        <li>
          <a href={localeUrl(lang, '/portfolio')}>
            <OSIcon name="internet" size={22} />
            {t('os.internet')}
          </a>
        </li>
        <li class="sm-sep" aria-hidden="true"></li>
        {
          carpetas.map((c) => (
            <li>
              <a href={localeUrl(lang, `/carpeta/${c.slug}`)}>
                <OSIcon name="folder" size={22} />
                {c[lang]}
              </a>
            </li>
          ))
        }
        <li class="sm-sep" aria-hidden="true"></li>
        <li>
          <a href={localeUrl(lang, '/estudio')}>
            <OSIcon name="notepad" size={22} />
            {t('os.sobremi')}
          </a>
        </li>
        <li>
          <a href={localeUrl(lang, '/contacto')}>
            <OSIcon name="mail" size={22} />
            {t('nav.contacto')}
          </a>
        </li>
      </ul>
    </div>
  </details>

  <div class="tasks">
    {
      win && (
        <button class="w2k-btn task-btn" aria-pressed="true" data-task-btn>
          <OSIcon name={win.icon} size={16} />
          <span class="task-title">{win.title}</span>
        </button>
      )
    }
  </div>

  <div class="tray">
    <span class="langs" aria-label={t('os.idioma')}>
      <a href={switchLocalePath(path, 'es')} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
      <span aria-hidden="true">/</span>
      <a href={switchLocalePath(path, 'en')} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    </span>
    <time class="clock" data-clock data-lang={lang}></time>
  </div>
</nav>

<style>
  .taskbar {
    position: fixed;
    z-index: 100;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: stretch;
    gap: 0.4rem;
    font-family: var(--w2k-font);
    height: var(--os-bar-h, 38px);
    padding: 3px 4px calc(3px + env(safe-area-inset-bottom, 0px));
    background: var(--w2k-face);
    color: var(--w2k-text);
    box-shadow: inset 0 1px 0 var(--w2k-hi), 0 -1px 0 var(--w2k-shadow);
  }
  .start {
    position: relative;
  }
  .start-btn {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    height: 100%;
    padding: 0 0.8rem 0 0.5rem;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--w2k-text);
    list-style: none;
  }
  .start-btn::-webkit-details-marker {
    display: none;
  }
  .start[open] .start-btn {
    box-shadow:
      inset 1px 1px 0 var(--w2k-dark),
      inset -1px -1px 0 var(--w2k-light),
      inset 2px 2px 0 var(--w2k-shadow),
      inset -2px -2px 0 var(--w2k-hi);
  }

  /* Menú Inicio Win2000: banner lateral + lista con iconos */
  .start-menu {
    position: absolute;
    bottom: calc(100% + 5px);
    left: 0;
    display: flex;
    min-width: 240px;
    background: var(--w2k-face);
    box-shadow:
      inset -1px -1px 0 var(--w2k-dark),
      inset 1px 1px 0 var(--w2k-light),
      inset -2px -2px 0 var(--w2k-shadow),
      inset 2px 2px 0 var(--w2k-hi),
      var(--w2k-window-shadow);
    padding: 3px;
    z-index: 200;
  }
  .sm-banner {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    background: linear-gradient(0deg, var(--w2k-title-a), var(--w2k-title-b));
    color: #fff;
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    padding: 0.7rem 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    user-select: none;
  }
  .sm-banner b {
    font-weight: 700;
  }
  .sm-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    flex: 1;
  }
  .sm-list a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 1.1rem 0.5rem 0.7rem;
    font-size: 0.83rem;
    color: var(--w2k-text);
    white-space: nowrap;
  }
  .sm-list a:hover,
  .sm-list a:focus-visible {
    background: var(--w2k-select);
    color: var(--w2k-select-text);
    outline: none;
  }
  .sm-sep {
    height: 0;
    margin: 0.25rem 0.5rem;
    border-top: 1px solid var(--w2k-shadow);
    border-bottom: 1px solid var(--w2k-hi);
  }
  .tasks {
    display: flex;
    flex: 1;
    min-width: 0;
    gap: 0.3rem;
  }
  .task-btn {
    max-width: 220px;
    min-width: 0;
    gap: 0.4rem;
    padding: 0 0.7rem;
    font-size: 0.8rem;
    justify-content: flex-start;
  }
  .task-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tray {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.7rem;
    padding: 0 0.7rem;
    font-size: 0.78rem;
    box-shadow:
      inset 1px 1px 0 var(--w2k-shadow),
      inset -1px -1px 0 var(--w2k-hi);
  }
  .clock {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .langs a {
    padding: 0.15rem 0.3rem;
    opacity: 0.55;
  }
  .langs a[aria-current] {
    opacity: 1;
    font-weight: 700;
  }
  .langs a:focus-visible {
    outline: 1px dotted currentColor;
    outline-offset: 1px;
  }
</style>

<script>
  // Reloj de la bandeja: HH:MM, cada medio minuto. Busca los nodos en cada
  // tick para sobrevivir a los swaps del ClientRouter (View Transitions).
  const tick = () => {
    const now = new Date();
    for (const c of document.querySelectorAll<HTMLElement>('[data-clock]')) {
      const locale = c.dataset.lang === 'en' ? 'en-GB' : 'es-ES';
      c.textContent = now.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
      c.setAttribute('datetime', now.toISOString());
    }
  };
  tick();
  setInterval(tick, 30_000);
  document.addEventListener('astro:page-load', tick);

  // Menú Inicio: <details> nativo (funciona sin JS); esto solo añade el
  // cierre con click-fuera y Escape. Listeners delegados en document (se
  // consultan en vivo → sobreviven a los swaps del ClientRouter).
  document.addEventListener('click', (e) => {
    const start = document.querySelector<HTMLDetailsElement>('[data-start]');
    if (start?.open && !start.contains(e.target as Node)) start.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelector<HTMLDetailsElement>('[data-start]')?.removeAttribute('open');
    }
  });
</script>
