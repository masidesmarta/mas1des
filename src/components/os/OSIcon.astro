---
/**
 * Iconos del OS (estilo Windows 2000, dibujados a mano en SVG).
 * `name` elige el dibujo; escalan al tamaño del contenedor (1em).
 * Decorativos: el texto accesible lo pone siempre el label del enlace.
 */
interface Props {
  name: 'folder' | 'internet' | 'notepad' | 'mail' | 'image' | 'window' | 'windows';
  /** Tamaño en px (ancho = alto). Por defecto hereda 1em. */
  size?: number;
}
const { name, size } = Astro.props;
// Sufijo único para los ids de gradientes (puede haber varios iconos por página).
const uid = Math.random().toString(36).slice(2, 7);
const dim = size ? `${size}px` : '1em';
---

<span class="os-icon" aria-hidden="true" style={`--icon-size:${dim}`}>
  {
    /* Carpeta amarilla clásica de Win2000: pestaña atrás + frente recto con brillo */
    name === 'folder' && (
      <svg viewBox="0 0 32 32">
        <defs>
          <linearGradient id={`f-${uid}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff3b8" />
            <stop offset="0.55" stop-color="#fcd968" />
            <stop offset="1" stop-color="#e9a83a" />
          </linearGradient>
        </defs>
        <path
          d="M2.5 8.2a1 1 0 0 1 1-1h7.6a1 1 0 0 1 .78.37l2 2.43H28.5a1 1 0 0 1 1 1v2H2.5Z"
          fill="#dfa235"
          stroke="#7a5018"
          stroke-width="0.9"
        />
        <rect
          x="2.5"
          y="11.6"
          width="27"
          height="14"
          rx="1"
          fill={`url(#f-${uid})`}
          stroke="#7a5018"
          stroke-width="0.9"
        />
        <path d="M4.2 13h23.6" stroke="#fffbe2" stroke-width="1" stroke-linecap="round" />
      </svg>
    )
  }
  {
    /* El icono CLÁSICO de Internet Explorer (bitmap original de 48px,
       nítido en tamaño nativo y pixel-perfect retro al escalar) */
    name === 'internet' && (
      <img class="ie-img" src="/icons/ie.png" alt="" width="48" height="48" loading="lazy" />
    )
  }
  {
    /* Bandera ondeante de Windows 95/2000 (para el botón Inicio) */
    name === 'windows' && (
      <svg viewBox="0 0 32 32">
        <g stroke="#1a1a1a" stroke-width="0.6" stroke-linejoin="round">
          <path d="M4 10.6q5.3-2.3 10.6-.9v6q-5.3-1.4-10.6.9Z" fill="#e3352a" />
          <path d="M16.4 10q5.6 1.4 11.6-.9v6q-6 2.3-11.6.9Z" fill="#3aab3a" />
          <path d="M4 18.4q5.3-2.3 10.6-.9v6q-5.3-1.4-10.6.9Z" fill="#2e5fe0" />
          <path d="M16.4 17.8q5.6 1.4 11.6-.9v6q-6 2.3-11.6.9Z" fill="#f5c518" />
        </g>
      </svg>
    )
  }
  {
    name === 'notepad' && (
      <svg viewBox="0 0 32 32">
        <path d="M6 4h17l4 4v20H6Z" fill="#fff" stroke="#7d7d72" stroke-width="1" />
        <path d="M23 4v4h4Z" fill="#d5d2c8" stroke="#7d7d72" stroke-width="1" />
        <g stroke="#9db6d6" stroke-width="1.2">
          <line x1="9.5" y1="12" x2="23.5" y2="12" />
          <line x1="9.5" y1="16" x2="23.5" y2="16" />
          <line x1="9.5" y1="20" x2="23.5" y2="20" />
          <line x1="9.5" y1="24" x2="18" y2="24" />
        </g>
      </svg>
    )
  }
  {
    name === 'mail' && (
      <svg viewBox="0 0 32 32">
        <rect x="2.5" y="8" width="27" height="17.5" rx="1" fill="#fdfdf3" stroke="#8a8a78" />
        <path d="M3 9.2 16 19l13-9.8" fill="none" stroke="#a5a390" stroke-width="1.2" />
        <rect x="24" y="10.5" width="3.6" height="4.2" fill="#c8342b" opacity="0.9" />
      </svg>
    )
  }
  {
    name === 'image' && (
      <svg viewBox="0 0 32 32">
        <rect x="4" y="6" width="24" height="20" fill="#fff" stroke="#7d7d72" />
        <rect x="6.5" y="8.5" width="19" height="15" fill="#bcd7ee" />
        <path d="M6.5 21.5 13 14l5 5.5 3-3 4.5 5Z" fill="#4e8f4e" />
        <circle cx="21.5" cy="12" r="2" fill="#ffd24a" />
      </svg>
    )
  }
  {
    name === 'window' && (
      <svg viewBox="0 0 32 32">
        <rect x="3" y="5" width="26" height="22" fill="#d4d0c8" stroke="#404040" />
        <rect x="4.5" y="6.5" width="23" height="4" fill="#0a246a" />
        <rect x="4.5" y="12.5" width="23" height="13" fill="#fff" />
      </svg>
    )
  }
</span>

<style>
  .os-icon {
    display: inline-flex;
    width: var(--icon-size, 1em);
    height: var(--icon-size, 1em);
    flex: none;
  }
  .os-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .os-icon .ie-img {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated; /* al ampliar/reducir, píxel retro nítido */
  }
</style>
