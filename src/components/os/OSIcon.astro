---
/**
 * Iconos del OS (estilo Windows 2000, dibujados a mano en SVG).
 * `name` elige el dibujo; escalan al tamaño del contenedor (1em).
 * Decorativos: el texto accesible lo pone siempre el label del enlace.
 */
interface Props {
  name: 'folder' | 'internet' | 'notepad' | 'mail' | 'image' | 'window';
  /** Tamaño en px (ancho = alto). Por defecto hereda 1em. */
  size?: number;
}
const { name, size } = Astro.props;
// Sufijo único para los ids de gradientes (puede haber varios iconos por página).
const uid = Math.random().toString(36).slice(2, 7);
const dim = size ? `${size}px` : '1em';
---

<span class="os-icon" aria-hidden="true" style={`--icon-size:${dim}`}>
  {
    name === 'folder' && (
      <svg viewBox="0 0 32 32">
        <defs>
          <linearGradient id={`f-${uid}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffeaa6" />
            <stop offset="1" stop-color="#edb937" />
          </linearGradient>
        </defs>
        <path
          d="M2 7h9.4l2.8 3H30v15.5A1.5 1.5 0 0 1 28.5 27h-25A1.5 1.5 0 0 1 2 25.5Z"
          fill="#c98f1b"
        />
        <path d="M2 7h9.4l2.8 3H30v2.6H2Z" fill="#e8ad2a" />
        <path
          d="M4.6 12.6H30l-2.1 12.6a1.5 1.5 0 0 1-1.5 1.25H3.1Z"
          fill={`url(#f-${uid})`}
          stroke="#a97b12"
          stroke-width="0.75"
        />
      </svg>
    )
  }
  {
    name === 'internet' && (
      <svg viewBox="0 0 32 32">
        <defs>
          <linearGradient id={`ie-${uid}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#6ec6ff" />
            <stop offset="1" stop-color="#1358b8" />
          </linearGradient>
        </defs>
        <circle cx="16" cy="16.5" r="12.5" fill={`url(#ie-${uid})`} />
        <text
          x="15.5"
          y="23"
          text-anchor="middle"
          font-family="Tahoma, Verdana, sans-serif"
          font-size="19"
          font-weight="700"
          fill="#fff"
        >
          e
        </text>
        <ellipse
          cx="16"
          cy="15"
          rx="14.4"
          ry="5.4"
          fill="none"
          stroke="#ffd24a"
          stroke-width="1.7"
          transform="rotate(-16 16 15)"
        />
      </svg>
    )
  }
  {
    name === 'notepad' && (
      <svg viewBox="0 0 32 32">
        <path d="M6 4h17l4 4v20H6Z" fill="#fff" stroke="#7d7d72" stroke-width="1" />
        <path d="M23 4v4h4Z" fill="#d5d2c8" stroke="#7d7d72" stroke-width="1" />
        <g stroke="#9db6d6" stroke-width="1.2">
          <line x1="9.5" y1="12" x2="23.5" y2="12" />
          <line x1="9.5" y1="16" x2="23.5" y2="16" />
          <line x1="9.5" y1="20" x2="23.5" y2="20" />
          <line x1="9.5" y1="24" x2="18" y2="24" />
        </g>
      </svg>
    )
  }
  {
    name === 'mail' && (
      <svg viewBox="0 0 32 32">
        <rect x="2.5" y="8" width="27" height="17.5" rx="1" fill="#fdfdf3" stroke="#8a8a78" />
        <path d="M3 9.2 16 19l13-9.8" fill="none" stroke="#a5a390" stroke-width="1.2" />
        <rect x="24" y="10.5" width="3.6" height="4.2" fill="#c8342b" opacity="0.9" />
      </svg>
    )
  }
  {
    name === 'image' && (
      <svg viewBox="0 0 32 32">
        <rect x="4" y="6" width="24" height="20" fill="#fff" stroke="#7d7d72" />
        <rect x="6.5" y="8.5" width="19" height="15" fill="#bcd7ee" />
        <path d="M6.5 21.5 13 14l5 5.5 3-3 4.5 5Z" fill="#4e8f4e" />
        <circle cx="21.5" cy="12" r="2" fill="#ffd24a" />
      </svg>
    )
  }
  {
    name === 'window' && (
      <svg viewBox="0 0 32 32">
        <rect x="3" y="5" width="26" height="22" fill="#d4d0c8" stroke="#404040" />
        <rect x="4.5" y="6.5" width="23" height="4" fill="#0a246a" />
        <rect x="4.5" y="12.5" width="23" height="13" fill="#fff" />
      </svg>
    )
  }
</span>

<style>
  .os-icon {
    display: inline-flex;
    width: var(--icon-size, 1em);
    height: var(--icon-size, 1em);
    flex: none;
  }
  .os-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
