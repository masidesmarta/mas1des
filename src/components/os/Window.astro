---
/**
 * Ventana Win2000: titlebar con degradado + minimizar/maximizar/cerrar,
 * toolbar y statusbar opcionales (slots) y cuerpo con scroll propio.
 *
 * Responsive temático: en móvil la ventana es SIEMPRE pantalla completa
 * (bajo la status bar); en desktop flota centrada según `size`.
 * Cerrar es un enlace real (funciona sin JS); minimizar/maximizar los
 * habilita el window-manager (hasta entonces van ocultos).
 */
import OSIcon from './OSIcon.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import type { OSIconName } from '../../os/types';

interface Props {
  lang: Lang;
  title: string;
  icon: OSIconName;
  /** A dónde lleva la ✕ (normalmente el escritorio o la carpeta madre). */
  closeHref: string;
  /** sm = app pequeña · md = explorador · max = visor casi maximizado. */
  size?: 'sm' | 'md' | 'max';
  /** El título de la ventana es el h1 de la página (explorador, apps). */
  titleAsH1?: boolean;
}
const { lang, title, icon, closeHref, size = 'md', titleAsH1 = false } = Astro.props;
const t = useTranslations(lang);
---

<section class="window" data-window data-size={size} aria-label={title}>
  <header class="titlebar" data-drag-handle>
    <OSIcon name={icon} size={16} />
    {titleAsH1 ? <h1 class="wtitle">{title}</h1> : <p class="wtitle">{title}</p>}
    <span class="controls">
      <button class="w2k-btn wbtn" data-win="min" aria-label={t('os.minimizar')} hidden>
        <svg viewBox="0 0 10 10" aria-hidden="true"><rect x="1" y="7.2" width="7" height="1.8" fill="currentColor" /></svg>
      </button>
      <button
        class="w2k-btn wbtn"
        data-win="max"
        aria-label={t('os.maximizar')}
        data-label-max={t('os.maximizar')}
        data-label-restore={t('os.restaurar')}
        hidden
      >
        <svg viewBox="0 0 10 10" aria-hidden="true">
          <rect x="1.4" y="1.4" width="7.2" height="7.2" fill="none" stroke="currentColor" stroke-width="1.3" />
          <rect x="1.4" y="1.4" width="7.2" height="2" fill="currentColor" />
        </svg>
      </button>
      <a class="w2k-btn wbtn wbtn-close" href={closeHref} aria-label={t('os.cerrar')}>
        <svg viewBox="0 0 10 10" aria-hidden="true">
          <path d="M1.6 1.6 8.4 8.4 M8.4 1.6 1.6 8.4" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </span>
  </header>

  {
    Astro.slots.has('toolbar') && (
      <div class="toolbar">
        <slot name="toolbar" />
      </div>
    )
  }

  <div class="window-body os-scroll">
    <slot />
  </div>

  {
    Astro.slots.has('statusbar') && (
      <div class="statusbar">
        <slot name="statusbar" />
      </div>
    )
  }
</section>

<style>
  .window {
    display: flex;
    flex-direction: column;
    background: var(--w2k-face);
    padding: 3px;
    box-shadow:
      inset -1px -1px 0 var(--w2k-dark),
      inset 1px 1px 0 var(--w2k-light),
      inset -2px -2px 0 var(--w2k-shadow),
      inset 2px 2px 0 var(--w2k-hi);
    /* Móvil: pantalla completa bajo la status bar */
    position: fixed;
    inset: var(--os-top) 0 0 0;
    z-index: 10;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 3px 3px 3px 7px;
    min-height: 28px;
    background: linear-gradient(90deg, var(--w2k-title-a), var(--w2k-title-b));
    color: var(--w2k-title-text);
    user-select: none;
    flex: none;
  }
  .wtitle {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-family: var(--w2k-font);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 1px 1px 0 rgba(0, 0, 30, 0.4);
  }
  .controls {
    display: flex;
    gap: 2px;
    flex: none;
  }
  .wbtn {
    width: 24px;
    height: 22px;
    color: var(--w2k-text);
  }
  .wbtn svg {
    width: 10px;
    height: 10px;
    display: block;
  }

  .toolbar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 4px 6px;
    font-family: var(--w2k-font);
    font-size: 0.8rem;
    border-bottom: 1px solid var(--w2k-shadow);
    box-shadow: 0 1px 0 var(--w2k-hi);
    min-width: 0;
  }

  .window-body {
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: #fff;
    box-shadow:
      inset -1px -1px 0 var(--w2k-hi),
      inset 1px 1px 0 var(--w2k-shadow);
  }

  .statusbar {
    flex: none;
    display: flex;
    gap: 1.25rem;
    padding: 3px 9px;
    font-family: var(--w2k-font);
    font-size: 0.74rem;
    color: var(--w2k-text);
    box-shadow: inset 0 1px 0 var(--w2k-shadow), inset 0 2px 0 var(--w2k-hi);
  }

  /* ---- Desktop: ventana flotante ---- */
  @media (min-width: 768px) {
    .window {
      position: relative;
      inset: auto;
      box-shadow:
        inset -1px -1px 0 var(--w2k-dark),
        inset 1px 1px 0 var(--w2k-light),
        inset -2px -2px 0 var(--w2k-shadow),
        inset 2px 2px 0 var(--w2k-hi),
        var(--w2k-window-shadow);
    }
    .window[data-size='sm'] {
      width: min(640px, 94vw);
      max-height: calc(100svh - var(--os-bar-h) - 4.5rem);
    }
    .window[data-size='md'] {
      width: min(960px, 94vw);
      height: min(680px, calc(100svh - var(--os-bar-h) - 4rem));
    }
    .window[data-size='max'] {
      /* Casi maximizada pero con tope: en monitores muy anchos el contenido
         editorial no necesita 2500px y quedaría un vacío enorme. */
      width: min(calc(100vw - 64px), 1500px);
      height: calc(100svh - var(--os-bar-h) - 44px);
    }

    /* Estados del window-manager (solo desktop) */
    .window.is-max {
      position: fixed;
      inset: 0 0 var(--os-bar-h) 0;
      width: auto !important;
      height: auto !important;
      max-height: none !important;
      transform: none !important;
      z-index: 20;
    }
    .window.is-min {
      display: none;
    }
    .titlebar {
      touch-action: none; /* el drag gestiona el pointer */
    }

    @media (prefers-reduced-motion: no-preference) {
      .window {
        animation: win-open 0.2s var(--w2k-ease);
      }
    }
  }

  @keyframes win-open {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>

<script>
  /**
   * Window-manager mínimo (progressive enhancement, solo desktop):
   *  - drag desde la titlebar (transform, clamp al viewport, sin persistir)
   *  - maximizar/restaurar (toggle CSS)
   *  - minimizar → restaurar desde el botón de la taskbar
   * Sin JS la ventana funciona igual (scroll propio + cerrar como enlace).
   */
  function initWindowManager() {
    const win = document.querySelector<HTMLElement>('[data-window]');
    if (!win || win.dataset.wmInit) return;
    if (!window.matchMedia('(min-width: 768px)').matches) return; // móvil: fullscreen
    win.dataset.wmInit = '1';

    const minBtn = win.querySelector<HTMLButtonElement>('[data-win="min"]');
    const maxBtn = win.querySelector<HTMLButtonElement>('[data-win="max"]');
    const taskBtn = document.querySelector<HTMLButtonElement>('[data-task-btn]');
    minBtn?.removeAttribute('hidden');
    maxBtn?.removeAttribute('hidden');

    // Maximizar / restaurar
    maxBtn?.addEventListener('click', () => {
      const maxed = win.classList.toggle('is-max');
      if (maxed) win.style.transform = '';
      maxBtn.setAttribute(
        'aria-label',
        (maxed ? maxBtn.dataset.labelRestore : maxBtn.dataset.labelMax) ?? '',
      );
      maxBtn.setAttribute('aria-pressed', String(maxed));
    });

    // Minimizar → el botón de la taskbar restaura
    minBtn?.addEventListener('click', () => {
      win.classList.add('is-min');
      taskBtn?.setAttribute('aria-pressed', 'false');
      taskBtn?.focus();
    });
    taskBtn?.addEventListener('click', () => {
      const min = win.classList.toggle('is-min');
      taskBtn.setAttribute('aria-pressed', String(!min));
    });

    // Drag sencillo desde la titlebar
    const handle = win.querySelector<HTMLElement>('[data-drag-handle]');
    if (!handle) return;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let baseTx = 0;
    let baseTy = 0;
    let baseRect: DOMRect | null = null;

    handle.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button, a')) return;
      if (win.classList.contains('is-max')) return;
      dragging = true;
      startX = e.clientX;
      startY = e.clientY;
      const tr = getComputedStyle(win).transform;
      const m = tr === 'none' ? new DOMMatrixReadOnly() : new DOMMatrixReadOnly(tr);
      baseTx = m.m41;
      baseTy = m.m42;
      const r = win.getBoundingClientRect();
      // Posición "sin transform" de la ventana, para el clamp
      baseRect = new DOMRect(r.left - baseTx, r.top - baseTy, r.width, r.height);
      handle.setPointerCapture(e.pointerId);
    });

    handle.addEventListener('pointermove', (e) => {
      if (!dragging || !baseRect) return;
      let tx = baseTx + e.clientX - startX;
      let ty = baseTy + e.clientY - startY;
      // Clamp: la titlebar siempre visible (y sin colarse bajo la taskbar)
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const minVisible = 110;
      tx = Math.max(minVisible - baseRect.width - baseRect.left + 40, Math.min(tx, vw - baseRect.left - minVisible));
      ty = Math.max(-baseRect.top + 6, Math.min(ty, vh - baseRect.top - 80));
      win.style.transform = `translate(${tx}px, ${ty}px)`;
    });

    const stop = () => {
      dragging = false;
      baseRect = null;
    };
    handle.addEventListener('pointerup', stop);
    handle.addEventListener('pointercancel', stop);
  }

  initWindowManager();
  document.addEventListener('astro:page-load', initWindowManager);
</script>
