---
/**
 * Contenido de "Estudio / Sobre mí" (bio, experiencia, formación,
 * herramientas). Compartido por la app Bloc de notas del escritorio y
 * por la versión web dentro de Internet Explorer (/portfolio/estudio).
 * Los textos los edita Marta en el CMS (singleton "Sobre mí / Estudio").
 */
import { getEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { localeUrl, pickLang, richText } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** A dónde lleva el CTA de contacto (app de correo o versión web). */
  contactHref?: string;
}
const { lang, contactHref } = Astro.props;
const t = useTranslations(lang);
const ctaHref = contactHref ?? localeUrl(lang, '/contacto');

const data = (await getEntry('sitio', 'estudio'))?.data;
const lead = pickLang(data, 'lead', lang) || t('estudio.lead');
const bioHtml = richText(pickLang(data, 'bio', lang));
const experiencia = (data?.experiencia ?? []).map((e) => ({
  puesto: pickLang(e, 'puesto', lang),
  lugar: pickLang(e, 'lugar', lang),
  fechas: pickLang(e, 'fechas', lang),
}));
const formacion = (data?.formacion ?? []).map((f) => ({
  titulo: pickLang(f, 'titulo', lang),
  lugar: pickLang(f, 'lugar', lang),
  fechas: pickLang(f, 'fechas', lang),
}));
const destrezas = (data?.herramientas ?? []).map((d) => ({
  grupo: pickLang(d, 'grupo', lang),
  items: d.items ?? [],
}));
---

<div class="doc">
  <section class="head">
    <p class="eyebrow">{t('estudio.kicker')}</p>
    <h1 class="dot-title">Marta Masides</h1>
    <p class="lead">{lead}</p>
  </section>

  {bioHtml && <section class="bio" set:html={bioHtml} />}

  <hr class="hr" />

  <section class="block">
    <div class="cols">
      <div class="col">
        <h2>{t('estudio.experiencia')}</h2>
        <ul class="entries" role="list">
          {
            experiencia.map((e) => (
              <li>
                <span class="entry-fecha">{e.fechas}</span>
                <span class="entry-puesto">{e.puesto}</span>
                <span class="entry-lugar">{e.lugar}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="col">
        <h2>{t('estudio.formacion')}</h2>
        <ul class="entries" role="list">
          {
            formacion.map((f) => (
              <li>
                <span class="entry-fecha">{f.fechas}</span>
                <span class="entry-puesto">{f.titulo}</span>
                <span class="entry-lugar">{f.lugar}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <hr class="hr" />

  <section class="block">
    <h2>{t('estudio.herramientas')}</h2>
    <div class="destrezas">
      {
        destrezas.map((d) => (
          <div class="destreza">
            <p class="eyebrow">{d.grupo}</p>
            <ul role="list">
              {d.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="cta-row">
      <a href={ctaHref} class="link-underline">{t('estudio.cta')} →</a>
    </div>
  </section>
</div>

<style>
  .doc {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100%;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem) clamp(1.25rem, 1rem + 2vw, 2.75rem)
      clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .head h1 {
    margin: 0.9rem 0 1rem;
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3.2rem);
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.4;
    max-width: 48ch;
  }
  .bio {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    color: var(--ink-soft);
  }
  /* :global — los <p> vienen de set:html (richText del CMS) */
  .bio :global(p) {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }
  .block {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    max-width: 920px;
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: 1.4rem;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .entries li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .entry-fecha {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .entry-puesto {
    color: var(--ink);
    font-weight: 500;
  }
  .entry-lugar {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .destrezas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    max-width: 820px;
  }
  .destreza ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--ink-soft);
  }
  .cta-row {
    margin-top: 2.25rem;
    font-size: var(--step-0);
  }
  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .destrezas {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
