---
/**
 * <head> compartido por los dos layouts del sitio (OS y editorial):
 * SEO (canonical, hreflang, OG, JSON-LD), favicons y fuentes.
 * Los layouts solo añaden encima sus estilos/slots propios.
 */
import { stripLocale, localeUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Precarga de SciFly (solo la usan las páginas editoriales con wordmark/hero). */
  preloadDisplayFont?: boolean;
}

const {
  title = 'Marta Masides — Arquitecta',
  description = 'Portfolio de Marta Masides, arquitecta por la ETSAM. Proyectos académicos y profesionales de arquitectura, interiorismo y visualización.',
  lang = 'es',
  preloadDisplayFont = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://mas1des.vercel.app');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

// Alternates hreflang (misma página en cada idioma)
const basePath = stripLocale(Astro.url.pathname);
const altEs = new URL(localeUrl('es', basePath), site).href;
const altEn = new URL(localeUrl('en', basePath), site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marta Masides',
  jobTitle: 'Arquitecta',
  url: site.href,
  image: ogImage,
  address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Escuela Técnica Superior de Arquitectura de Madrid (ETSAM)',
  },
  knowsAbout: ['Arquitectura', 'Interiorismo', 'Visualización arquitectónica', 'BIM'],
  sameAs: ['https://instagram.com/mas1des'],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{
  /* Precarga del display SciFly (wordmark + nombre del hero, above-the-fold) → sin FOUT */
  preloadDisplayFont && (
    <link rel="preload" href="/fonts/scifly-sans.woff2" as="font" type="font/woff2" crossorigin />
  )
}
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={altEs} />
<link rel="alternate" hreflang="en" href={altEn} />
<link rel="alternate" hreflang="x-default" href={altEs} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Marta Masides" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Marta Masides — Arquitecta" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#f5f3ef" />
<script is:inline>
  document.documentElement.classList.remove('no-js');
</script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
