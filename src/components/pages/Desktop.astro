---
/**
 * La home del sitio: el escritorio sin ventanas. Tanto los iconos como la
 * firma de esquina (que aquí es el h1 real y el <main>) los pinta OSLayout
 * como capas persistentes; esta página solo aporta título y descripción.
 */
import OSLayout from '../../layouts/OSLayout.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<OSLayout lang={lang} title={t('meta.arquitecta')} description={t('meta.homeDesc')} />
