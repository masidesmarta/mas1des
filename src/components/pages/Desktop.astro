---
/**
 * La home del sitio: el escritorio (desktop) / pantalla de inicio (móvil).
 * Carpetas por categoría del CMS + apps (Internet = modo lectura,
 * Sobre mí, Contacto). Todo son enlaces reales a rutas SSR.
 */
import { getCollection } from 'astro:content';
import OSLayout from '../../layouts/OSLayout.astro';
import DesktopIcon from '../os/DesktopIcon.astro';
import { CATEGORIAS } from '../../os/categorias';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl, projectsFor } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = projectsFor(await getCollection('proyectos'), lang);
// Carpetas con contenido; una carpeta es "WIP" si TODO lo de dentro es provisional.
const carpetas = CATEGORIAS.map((c) => {
  const dentro = all.filter((p) => p.entry.data.categoria === c.slug);
  return {
    ...c,
    count: dentro.length,
    wip: dentro.length > 0 && dentro.every((p) => p.entry.data.provisional),
  };
}).filter((c) => c.count > 0);
---

<OSLayout lang={lang} title={t('meta.arquitecta')} description={t('meta.homeDesc')}>
  <main id="main" class="desktop">
    <nav class="icons" aria-label={t('os.escritorio')}>
      {
        carpetas.map((c) => (
          <DesktopIcon
            href={localeUrl(lang, `/carpeta/${c.slug}`)}
            icon="folder"
            label={c[lang]}
            badge={c.wip ? 'WIP' : undefined}
          />
        ))
      }
      <DesktopIcon href={localeUrl(lang, '/portfolio')} icon="internet" label={t('os.internet')} />
      <DesktopIcon href={localeUrl(lang, '/estudio')} icon="notepad" label={t('os.sobremi')} />
      <DesktopIcon href={localeUrl(lang, '/contacto')} icon="mail" label={t('nav.contacto')} />
    </nav>

    {/* Firma tipo "Windows 2000 Professional" en la esquina: es el h1 real. */}
    <h1 class="watermark">
      Marta Masides<span class="watermark-sub">{t('os.watermarkRole')}</span>
    </h1>
  </main>
</OSLayout>

<style>
  .desktop {
    min-height: 100svh;
    padding: calc(var(--os-top) + 1.25rem) 1rem calc(var(--os-bottom) + 4.5rem);
    display: flex;
    flex-direction: column;
  }

  /* Móvil: rejilla tipo pantalla de inicio de un teléfono */
  .icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem 0.5rem;
    align-content: start;
    max-width: 26rem;
    margin-inline: auto;
    width: 100%;
    flex: 1;
  }

  .watermark {
    margin-top: auto;
    align-self: center;
    text-align: center;
    font-family: var(--w2k-font);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 1px 1px 0 rgba(0, 0, 20, 0.7);
    line-height: 1.5;
  }
  .watermark-sub {
    display: block;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  /* Desktop: iconos en columnas desde arriba-izquierda (como Windows)
     y firma en la esquina inferior derecha (como la build del sistema). */
  @media (min-width: 768px) {
    .desktop {
      padding: 2rem 1.5rem calc(var(--os-bottom) + 2.5rem);
    }
    .icons {
      grid-template-columns: none;
      grid-template-rows: repeat(auto-fill, minmax(108px, auto));
      grid-auto-flow: column;
      grid-auto-columns: 110px;
      justify-content: start;
      align-content: start;
      gap: 0.6rem;
      max-width: none;
      margin-inline: 0;
      max-height: calc(100svh - var(--os-bar-h) - 8rem);
    }
    .watermark {
      align-self: flex-end;
      text-align: right;
      margin-top: auto;
    }
    .watermark-sub {
      letter-spacing: 0.18em;
    }
  }
</style>
