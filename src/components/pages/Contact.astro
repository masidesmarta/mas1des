---
/**
 * Contacto como ventana de correo (app del escritorio): cabecera
 * "Para / Asunto" + el contenido compartido de ContactContent (que
 * también usa la versión web del modo lectura en /portfolio/contacto).
 */
import OSLayout from '../../layouts/OSLayout.astro';
import Window from '../os/Window.astro';
import ContactContent from '../ContactContent.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const paraLabel = lang === 'en' ? 'To' : 'Para';
const asuntoLabel = lang === 'en' ? 'Subject' : 'Asunto';
const asunto = lang === 'en' ? 'New project ✏️' : 'Nuevo proyecto ✏️';
---

<OSLayout
  lang={lang}
  title={`${t('contacto.kicker')} — Marta Masides`}
  description={t('contacto.lead')}
  window={{ title: t('nav.contacto'), icon: 'mail' }}
>
  <main id="main" class="window-stage">
    <Window lang={lang} title={t('nav.contacto')} icon="mail" closeHref={localeUrl(lang, '/')} size="sm">
      <div class="mail-head" slot="toolbar">
        <span class="mh-row">
          <span class="mh-label">{paraLabel}:</span>
          <span class="mh-value bevel-down">masidesmarta@gmail.com</span>
        </span>
        <span class="mh-row">
          <span class="mh-label">{asuntoLabel}:</span>
          <span class="mh-value bevel-down">{asunto}</span>
        </span>
      </div>

      <ContactContent lang={lang} />
    </Window>
  </main>
</OSLayout>

<style>
  .mail-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    min-width: 0;
    padding-block: 2px;
  }
  .mh-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .mh-label {
    flex: none;
    width: 3.6rem;
    text-align: right;
    opacity: 0.8;
  }
  .mh-value {
    flex: 1;
    min-width: 0;
    padding: 0.22rem 0.5rem;
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
