---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProvisionalBadge from '../ProvisionalBadge.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
  entry: any;
  next: { entry: any; slug: string };
}
const { lang, entry, next } = Astro.props;
const t = useTranslations(lang);
const { data } = entry;
const { Content } = await render(entry);

const ficha = [
  [t('detail.year'), data.ano],
  [t('detail.location'), data.ubicacion],
  [t('detail.type'), data.tipo],
  [t('detail.role'), data.rol],
].filter(([, v]) => Boolean(v));

const [galLead, ...galRest] = data.galeria;
---

<Layout lang={lang} title={`${data.titulo} — Marta Masides`} description={data.resumen}>
  <article>
    <header class="head wrap">
      <a href={localeUrl(lang, '/proyectos')} class="back link-underline">
        ← {t('detail.back')}
      </a>
      <h1>{data.titulo}</h1>
      {data.resumen && <p class="lead">{data.resumen}</p>}
    </header>

    {
      data.portada && (
        <figure class="cover">
          <ProvisionalBadge show={data.provisional} lang={lang} />
          <Image
            src={data.portada}
            alt={data.titulo}
            widths={[600, 1000, 1600, 2000]}
            sizes="100vw"
            loading="eager"
            data-parallax="6"
          />
        </figure>
      )
    }

    <div class="body wrap">
      {
        ficha.length > 0 && (
          <dl class="spec">
            {ficha.map(([k, v]) => (
              <div class="spec-cell">
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </div>

    {
      data.galeria.length > 0 && (
        <section class="galeria-wrap wrap">
          {galLead && (
            <figure class="gal-lead">
              <Image
                src={galLead}
                alt={`${data.titulo} — ${t('detail.imageAlt')} 1`}
                widths={[800, 1200, 1800]}
                sizes="100vw"
              />
            </figure>
          )}
          {galRest.length > 0 && (
            <div class="galeria">
              {galRest.map((img: any, i: number) => (
                <figure>
                  <Image
                    src={img}
                    alt={`${data.titulo} — ${t('detail.imageAlt')} ${i + 2}`}
                    widths={[500, 900, 1400]}
                    sizes="(max-width: 720px) 100vw, 50vw"
                  />
                </figure>
              ))}
            </div>
          )}
        </section>
      )
    }

    {
      data.planos.length > 0 && (
        <section class="section wrap">
          <h2 class="planos-title">{t('detail.plans')}</h2>
          <div class="planos">
            {data.planos.map((img: any, i: number) => (
              <figure class="plano">
                <Image
                  src={img}
                  alt={`${data.titulo} — ${t('detail.planAlt')} ${i + 1}`}
                  widths={[600, 1000, 1600]}
                  sizes="100vw"
                />
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      next && (
        <a class="next-proj" href={localeUrl(lang, `/proyectos/${next.slug}`)}>
          <span class="np-inner wrap">
            <span class="np-label">{t('detail.next')}</span>
            <span class="np-title">
              {next.entry.data.titulo}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </span>
          </span>
        </a>
      )
    }
  </article>
</Layout>

<style>
  .head {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .back {
    color: var(--muted);
    font-size: var(--step--1);
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .head h1 {
    font-size: var(--step-4);
    max-width: 20ch;
  }
  .lead {
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.6rem);
    color: var(--ink-soft);
    margin-top: 1.2rem;
    line-height: 1.35;
    max-width: 40ch;
  }
  .cover {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-soft);
  }
  .cover img {
    position: absolute;
    top: -8%;
    left: 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }

  .body {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
  .spec {
    margin: 0 0 clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-block: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 11%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 11%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem clamp(2rem, 1rem + 5vw, 6rem);
  }
  .spec-cell dt {
    font-size: var(--step--1);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  .spec-cell dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }
  .prose {
    max-width: 68ch;
    color: #34302a;
    font-size: var(--step-0);
  }
  .prose :global(p) {
    margin: 0 0 1.3rem;
  }

  .galeria-wrap {
    padding-bottom: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .gal-lead {
    margin: 0 0 clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
    overflow: hidden;
    background: var(--paper-soft);
  }
  .gal-lead img {
    width: 100%;
    height: auto;
    display: block;
  }
  .galeria {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
  }
  .galeria figure {
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--paper-soft);
    overflow: hidden;
  }
  .galeria figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease);
  }
  .galeria figure:hover img {
    transform: scale(1.03);
  }

  .planos-title {
    margin-bottom: 1.5rem;
  }
  .plano {
    margin: 0 0 1.5rem;
    padding: clamp(1rem, 3vw, 2.5rem);
    background: #fff;
    border: 1px solid var(--line);
  }

  .next-proj {
    display: block;
    border-top: 1px solid color-mix(in srgb, var(--ink) 11%, transparent);
    margin-top: clamp(2rem, 1rem + 3vw, 4rem);
  }
  .np-inner {
    display: block;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    transition: padding-left 0.45s var(--ease);
  }
  .next-proj:hover .np-inner {
    padding-left: 1.4rem;
  }
  .np-label {
    display: block;
    font-size: var(--step--1);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .np-title {
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 0.3s var(--ease);
  }
  .next-proj:hover .np-title {
    color: var(--accent);
  }
  .np-title .arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: var(--accent);
    transition: transform 0.4s var(--ease);
  }
  .next-proj:hover .arrow {
    transform: translateX(6px);
  }

  @media (max-width: 600px) {
    .galeria {
      grid-template-columns: 1fr;
    }
    .head h1 {
      font-size: var(--step-3);
    }
  }
</style>
