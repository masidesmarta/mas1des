---
/**
 * Ficha de proyecto como ventana-visor casi maximizada (tipo lector),
 * para ver la obra grande. El contenido dentro mantiene la voz
 * editorial (Inter, papel, tinto); el chrome es Win2000.
 */
import { Image } from 'astro:assets';
import OSLayout from '../../layouts/OSLayout.astro';
import Window from '../os/Window.astro';
import ProvisionalBadge from '../ProvisionalBadge.astro';
import { categoriaLabel } from '../../os/categorias';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl, richText } from '../../i18n/utils';

interface Props {
  lang: Lang;
  entry: any;
  next: { entry: any; slug: string };
}
const { lang, entry, next } = Astro.props;
const t = useTranslations(lang);
const { data } = entry;

// La ✕ y el "Atrás" devuelven a la carpeta del proyecto.
const carpetaHref = localeUrl(lang, `/carpeta/${data.categoria}`);
const carpetaLabel = categoriaLabel(data.categoria, lang);

const ficha = [
  [t('detail.year'), data.ano],
  [t('detail.location'), data.ubicacion],
  [t('detail.type'), data.tipo],
  [t('detail.role'), data.rol],
].filter(([, v]) => Boolean(v));

const [galLead, ...galRest] = data.galeria;

// Composición de la galería: filas justificadas de 2 (misma altura por fila,
// ancho proporcional al formato) para mezclar verticales y horizontales sin
// recortar. La portada vertical se presenta como lámina en vez de a 16:9.
const esVertical = (img: any) => img && img.height > img.width;
const portadaVertical = esVertical(data.portada);
const galRows: any[][] = [];
for (let i = 0; i < galRest.length; i += 2) galRows.push(galRest.slice(i, i + 2));
---

<OSLayout
  lang={lang}
  title={`${data.titulo} — Marta Masides`}
  description={data.resumen}
  window={{ title: data.titulo, icon: 'image' }}
>
  <main id="main" class="window-stage">
    <Window
      lang={lang}
      title={data.titulo}
      icon="image"
      closeHref={carpetaHref}
      size="max"
    >
      <div class="viewer-toolbar" slot="toolbar">
        <a class="w2k-btn tb-btn" href={carpetaHref}>
          <span aria-hidden="true">←</span>
          {carpetaLabel}
        </a>
      </div>

      <article class="ficha">
        <header class="head wrap">
          <h1>{data.titulo}</h1>
          {data.resumen && <p class="lead">{data.resumen}</p>}
        </header>

        {
          data.portada && (
            <figure class:list={['cover', { 'cover--vertical': portadaVertical }]}>
              <ProvisionalBadge show={data.provisional} lang={lang} />
              <Image
                src={data.portada}
                alt={data.titulo}
                widths={[600, 1000, 1600, 2000]}
                sizes={portadaVertical ? '(max-width: 720px) 92vw, 60vh' : '100vw'}
                loading="eager"
              />
            </figure>
          )
        }

        <div class="body wrap">
          {
            ficha.length > 0 && (
              <dl class="spec">
                {ficha.map(([k, v]) => (
                  <div class="spec-cell">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          {data.descripcion && <div class="prose" set:html={richText(data.descripcion)} />}
        </div>

        {
          data.video && (
            <section class="video-wrap wrap">
              <video
                controls
                preload="none"
                playsinline
                poster={data.portada?.src}
                aria-label={`${data.titulo} — ${t('detail.video')}`}
              >
                <source src={data.video} type="video/mp4" />
              </video>
            </section>
          )
        }

        {
          data.galeria.length > 0 && (
            <section class="galeria-wrap wrap">
              {galLead && (
                <figure class:list={['gal-lead', { 'gal-lead--vertical': esVertical(galLead) }]}>
                  <Image
                    src={galLead}
                    alt={`${data.titulo} — ${t('detail.imageAlt')} 1`}
                    widths={[800, 1200, 1800]}
                    sizes={esVertical(galLead) ? '(max-width: 720px) 100vw, 62vh' : '100vw'}
                  />
                </figure>
              )}
              {galRows.map((row, r) => (
                <div class:list={['gal-row', { 'gal-row--solo': row.length === 1 }]}>
                  {row.map((img: any, i: number) => (
                    <figure
                      class:list={[{ 'es-vertical': esVertical(img) }]}
                      style={`--ar: ${(img.width / img.height).toFixed(4)}`}
                    >
                      <Image
                        src={img}
                        alt={`${data.titulo} — ${t('detail.imageAlt')} ${r * 2 + i + 2}`}
                        widths={[500, 900, 1400]}
                        sizes="(max-width: 720px) 100vw, 50vw"
                      />
                    </figure>
                  ))}
                </div>
              ))}
            </section>
          )
        }

        {
          data.planos.length > 0 && (
            <section class="section wrap">
              <h2 class="planos-title">{t('detail.plans')}</h2>
              <div class="planos">
                {data.planos.map((img: any, i: number) => (
                  <figure class="plano">
                    <Image
                      src={img}
                      alt={`${data.titulo} — ${t('detail.planAlt')} ${i + 1}`}
                      widths={[600, 1000, 1600]}
                      sizes="100vw"
                    />
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          next && (
            <a class="next-proj" href={localeUrl(lang, `/proyectos/${next.slug}`)}>
              <span class="np-inner wrap">
                <span class="np-label">{t('detail.next')}</span>
                <span class="np-title">
                  {next.entry.data.titulo}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </span>
            </a>
          )
        }
      </article>
    </Window>
  </main>
</OSLayout>

<style>
  .viewer-toolbar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-width: 0;
  }
  .tb-btn {
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    font-size: 0.78rem;
    color: inherit;
    flex: none;
  }

  /* El interior del visor recupera la voz editorial del sitio */
  .ficha {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100%;
  }

  .head {
    padding-block: clamp(2rem, 1.2rem + 3vw, 3.5rem) clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }
  .head h1 {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.8rem);
    max-width: 20ch;
  }
  .lead {
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.45rem);
    color: var(--ink-soft);
    margin-top: 1.1rem;
    line-height: 1.35;
    max-width: 44ch;
  }
  /* La portada se muestra entera: horizontal a sangre completa con su
     proporción natural; vertical como lámina centrada sobre el papel. */
  .cover {
    position: relative;
    margin: 0;
    background: var(--paper-soft);
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cover--vertical {
    display: flex;
    justify-content: center;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .cover--vertical img {
    width: auto;
    max-width: min(92%, 640px);
    max-height: 74vh;
  }

  .body {
    padding-block: clamp(2rem, 1.2rem + 3vw, 4rem);
  }
  .spec {
    margin: 0 0 clamp(1.75rem, 1.25rem + 2vw, 3rem);
    padding-block: 1.3rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 11%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 11%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem clamp(2rem, 1rem + 5vw, 6rem);
  }
  .spec-cell dt {
    font-size: var(--step--1);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  .spec-cell dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
  }
  .prose {
    max-width: 68ch;
    color: #34302a;
    font-size: var(--step-0);
  }
  .prose :global(p) {
    margin: 0 0 1.3rem;
  }

  .video-wrap {
    padding-bottom: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    display: flex;
    justify-content: center;
  }
  .video-wrap video {
    display: block;
    width: 100%;
    max-width: 100%;
    max-height: 78vh;
    background: var(--ink);
    border-radius: 2px;
  }

  .galeria-wrap {
    padding-bottom: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .gal-lead {
    margin: 0 0 clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
    overflow: hidden;
    background: var(--paper-soft);
  }
  .gal-lead img {
    width: 100%;
    height: auto;
    display: block;
  }
  .gal-lead--vertical {
    display: flex;
    justify-content: center;
    background: none;
  }
  .gal-lead--vertical img {
    width: auto;
    max-width: min(100%, 620px);
    max-height: 72vh;
  }

  /* Filas justificadas: las imágenes de cada fila comparten altura y se
     reparten el ancho según su formato (--ar = ancho/alto) → verticales y
     horizontales conviven sin recortarse. */
  .gal-row {
    display: flex;
    gap: clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
    margin-bottom: clamp(0.75rem, 0.4rem + 1.5vw, 1.75rem);
  }
  .gal-row figure {
    margin: 0;
    flex: var(--ar, 1) 1 0%;
    min-width: 0;
    background: var(--paper-soft);
    overflow: hidden;
  }
  .gal-row figure img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.7s var(--ease);
  }
  .gal-row figure:hover img {
    transform: scale(1.03);
  }
  /* Última imagen suelta: la horizontal ocupa el ancho; la vertical se centra
     con un ancho contenido para no hacerse gigante. */
  .gal-row--solo {
    justify-content: center;
  }
  .gal-row--solo figure {
    flex: 0 1 auto;
  }
  .gal-row--solo figure.es-vertical {
    max-width: min(100%, 620px);
  }

  .planos-title {
    margin-bottom: 1.5rem;
  }
  .plano {
    margin: 0 0 1.5rem;
    padding: clamp(1rem, 3vw, 2.5rem);
    background: #fff;
    border: 1px solid var(--line);
  }

  .next-proj {
    display: block;
    border-top: 1px solid color-mix(in srgb, var(--ink) 11%, transparent);
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    overflow-x: clip;
  }
  .np-inner {
    display: block;
    padding-block: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    transition: transform 0.45s var(--ease);
  }
  .next-proj:hover .np-inner {
    transform: translateX(1.4rem);
  }
  .np-label {
    display: block;
    font-size: var(--step--1);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .np-title {
    font-size: clamp(1.5rem, 1.1rem + 2vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 0.3s var(--ease);
  }
  .next-proj:hover .np-title {
    color: var(--accent);
  }
  .np-title .arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: var(--accent);
    transition: transform 0.4s var(--ease);
  }
  .next-proj:hover .arrow {
    transform: translateX(6px);
  }

  @media (max-width: 600px) {
    .gal-row {
      flex-direction: column;
    }
    .gal-row figure,
    .gal-row--solo figure.es-vertical {
      flex: none;
      max-width: 100%;
    }
  }
</style>
