---
/**
 * "Sobre mí.txt" abierto en el Bloc de notas: la bio/CV de Marta
 * dentro de una ventana Notepad. Contenido editorial intacto.
 */
import OSLayout from '../../layouts/OSLayout.astro';
import Window from '../os/Window.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const experiencia = {
  es: [
    { puesto: 'Arquitecta en prácticas', lugar: 'Estudio Eduardo Navadijos', fechas: '2025 — 2026' },
    { puesto: 'Arquitecta en prácticas', lugar: 'CumuloLimbo — Arquitectura e Interiorismo', fechas: '2023 — 2024' },
    { puesto: 'Arquitecta en prácticas', lugar: 'ZOOCO — Arquitectura e Interiorismo', fechas: 'Junio — Julio 2023' },
  ],
  en: [
    { puesto: 'Architecture intern', lugar: 'Estudio Eduardo Navadijos', fechas: '2025 — 2026' },
    { puesto: 'Architecture intern', lugar: 'CumuloLimbo — Architecture & Interior design', fechas: '2023 — 2024' },
    { puesto: 'Architecture intern', lugar: 'ZOOCO — Architecture & Interior design', fechas: 'June — July 2023' },
  ],
}[lang];

const formacion = {
  es: [
    { titulo: 'Máster Habilitante en Arquitectura (ETSAM)', lugar: 'Universidad Politécnica de Madrid', fechas: '2025 — 2026' },
    { titulo: 'Grado en Estudios de Arquitectura', lugar: 'Escuela de Arquitectura de Alcalá de Henares', fechas: '2019 — 2025' },
    { titulo: 'Estancia — Escuela de Arquitectura de A Coruña (UDC)', lugar: 'Universidade da Coruña', fechas: '2021 — 2022' },
    { titulo: 'Máster en BIM I y II', lugar: 'Escuela 24 Studio Lab', fechas: '2025' },
  ],
  en: [
    { titulo: "Enabling Master's in Architecture (ETSAM)", lugar: 'Polytechnic University of Madrid', fechas: '2025 — 2026' },
    { titulo: "Bachelor's Degree in Architecture Studies", lugar: 'School of Architecture of Alcalá de Henares', fechas: '2019 — 2025' },
    { titulo: 'Exchange — School of Architecture of A Coruña (UDC)', lugar: 'Universidade da Coruña', fechas: '2021 — 2022' },
    { titulo: "Master's in BIM I & II", lugar: 'Escuela 24 Studio Lab', fechas: '2025' },
  ],
}[lang];

const destrezas = [
  { grupo: t('estudio.g.edicion'), items: ['Photoshop', 'Illustrator', 'InDesign'] },
  { grupo: t('estudio.g.planos'), items: ['Revit', 'AutoCAD', 'Rhinoceros'] },
  { grupo: t('estudio.g.render'), items: ['Lumion', 'Enscape'] },
];

const bio =
  lang === 'en'
    ? [
        'Across my time at different architecture studios I have taken part in producing installation and construction drawings, as well as renders, drawings and layout for competitions. I have also collaborated on photographic post-production and on featuring projects in specialized magazines and platforms.',
        'I complemented my training as an architect with a Master’s in BIM (BIM I & II), developing projects with tools like Revit and consolidating a technical base that I keep expanding in the professional field. This selection of projects shows my academic and professional path, my interests and my way of understanding architecture.',
      ]
    : [
        'A lo largo de mi paso por distintos estudios de arquitectura he participado en la realización de planos de instalaciones y construcción, así como en la elaboración de renders, dibujos y maquetación para concursos. También he colaborado en la postproducción fotográfica y en la difusión de proyectos en revistas y plataformas especializadas.',
        'He complementado mi formación como arquitecta con un Máster en BIM (BIM I y II), desarrollando proyectos con herramientas como Revit y consolidando una base técnica que sigo ampliando en el entorno profesional. En esta selección de proyectos muestro mi recorrido académico y profesional, mis intereses y mi manera de entender la arquitectura.',
      ];

const winTitle = `${t('os.sobremi')} — ${t('os.blocnotas')}`;
---

<OSLayout
  lang={lang}
  title={`${t('estudio.kicker')} — Marta Masides`}
  description={t('estudio.lead')}
  window={{ title: winTitle, icon: 'notepad' }}
>
  <main id="main" class="window-stage">
    <Window lang={lang} title={winTitle} icon="notepad" closeHref={localeUrl(lang, '/')} size="md">
      <div class="doc">
        <section class="head">
          <p class="eyebrow">{t('estudio.kicker')}</p>
          <h1 class="dot-title">Marta Masides</h1>
          <p class="lead">{t('estudio.lead')}</p>
        </section>

        <section class="bio">
          {bio.map((p) => <p>{p}</p>)}
        </section>

        <hr class="hr" />

        <section class="block">
          <div class="cols">
            <div class="col">
              <h2>{t('estudio.experiencia')}</h2>
              <ul class="entries" role="list">
                {
                  experiencia.map((e) => (
                    <li>
                      <span class="entry-fecha">{e.fechas}</span>
                      <span class="entry-puesto">{e.puesto}</span>
                      <span class="entry-lugar">{e.lugar}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="col">
              <h2>{t('estudio.formacion')}</h2>
              <ul class="entries" role="list">
                {
                  formacion.map((f) => (
                    <li>
                      <span class="entry-fecha">{f.fechas}</span>
                      <span class="entry-puesto">{f.titulo}</span>
                      <span class="entry-lugar">{f.lugar}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>

        <hr class="hr" />

        <section class="block">
          <h2>{t('estudio.herramientas')}</h2>
          <div class="destrezas">
            {
              destrezas.map((d) => (
                <div class="destreza">
                  <p class="eyebrow">{d.grupo}</p>
                  <ul role="list">
                    {d.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <div class="cta-row">
            <a href={localeUrl(lang, '/contacto')} class="link-underline">{t('estudio.cta')} →</a>
          </div>
        </section>
      </div>
    </Window>
  </main>
</OSLayout>

<style>
  /* El "documento" dentro del Bloc de notas: papel editorial */
  .doc {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100%;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem) clamp(1.25rem, 1rem + 2vw, 2.75rem)
      clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .head h1 {
    margin: 0.9rem 0 1rem;
    font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3.2rem);
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.4;
    max-width: 48ch;
  }
  .bio {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    color: var(--ink-soft);
  }
  .bio p {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }
  .block {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    max-width: 920px;
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: 1.4rem;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .entries li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .entry-fecha {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .entry-puesto {
    color: var(--ink);
    font-weight: 500;
  }
  .entry-lugar {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .destrezas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
    max-width: 820px;
  }
  .destreza ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--ink-soft);
  }
  .cta-row {
    margin-top: 2.25rem;
    font-size: var(--step-0);
  }
  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .destrezas {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
