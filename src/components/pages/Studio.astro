---
/**
 * "Sobre mí.txt" abierto en el Bloc de notas (app del escritorio).
 * El contenido vive en StudioContent (compartido con la versión web
 * del modo lectura en /portfolio/estudio).
 */
import OSLayout from '../../layouts/OSLayout.astro';
import Window from '../os/Window.astro';
import StudioContent from '../StudioContent.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const winTitle = `${t('os.sobremi')} — ${t('os.blocnotas')}`;
---

<OSLayout
  lang={lang}
  title={`${t('estudio.kicker')} — Marta Masides`}
  description={t('estudio.lead')}
  window={{ title: winTitle, icon: 'notepad' }}
>
  <main id="main" class="window-stage">
    <Window lang={lang} title={winTitle} icon="notepad" closeHref={localeUrl(lang, '/')} size="md">
      <StudioContent lang={lang} />
    </Window>
  </main>
</OSLayout>
