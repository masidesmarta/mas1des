---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProjectIndex from '../ProjectIndex.astro';
import mascota from '../../assets/mascota.png';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl, projectsFor } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = projectsFor(await getCollection('proyectos'), lang);
const destacados = all.filter((p) => p.entry.data.destacado);
const preview = (destacados.length >= 4 ? destacados : all).slice(0, 5);
const total = all.length;
---

<Layout lang={lang} title={t('meta.arquitecta')} description={t('meta.homeDesc')}>
  <section class="landing">
    <div class="wrap landing-inner">
      <div class="intro" data-reveal>
        <p class="eyebrow">{t('hero.kicker')}</p>
        <h1 class="name">Marta<br />Masides<span class="dot">.</span></h1>
        <p class="tag">{t('hero.tagline')}</p>
        <a href={localeUrl(lang, '/proyectos')} class="cta">
          <span>{t('hero.cta')}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mascota" data-reveal>
        <Image
          id="mascota"
          src={mascota}
          alt={t('hero.mascotaAlt')}
          widths={[400, 700, 900]}
          sizes="(max-width: 820px) 62vw, 40vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="preview">
    <div class="wrap preview-head" data-reveal>
      <div>
        <p class="eyebrow">{t('home.kicker')} · {total} {t('proyectos.count')}</p>
        <h2 class="dot-title">{t('home.proyectos')}</h2>
      </div>
      <span class="preview-count">
        <span class="pc-shown">{preview.length}</span> {t('home.de')} {total}
      </span>
    </div>

    <div class="wrap">
      <ProjectIndex items={preview} lang={lang} />
    </div>

    <div class="wrap all-row" data-reveal>
      <a href={localeUrl(lang, '/proyectos')} class="all-link">
        {t('home.vertodos')} <span class="arrow">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .landing {
    position: relative;
    min-height: calc(83svh - 72px);
    display: flex;
    align-items: center;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
    overflow: hidden;
  }
  .landing-inner {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 3rem);
    width: 100%;
  }
  .eyebrow {
    margin-bottom: 1.4rem;
  }
  .name {
    font-size: clamp(3.6rem, 1.5rem + 9.5vw, 10.5rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 0.9;
    margin-left: -0.02em;
  }
  .dot {
    color: var(--accent);
  }
  .tag {
    margin-top: 1.6rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 30ch;
    line-height: 1.4;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.4rem;
    padding: 0.85rem 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    font-size: var(--step-0);
    font-weight: 500;
    transition:
      background 0.35s var(--ease),
      gap 0.35s var(--ease);
  }
  .cta .arrow {
    transition: transform 0.35s var(--ease);
  }
  .cta:hover {
    background: var(--accent);
    gap: 1.1rem;
  }
  .cta:hover .arrow {
    transform: translateX(3px);
  }

  .mascota {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    margin-left: -6%;
  }
  .mascota img {
    position: relative;
    z-index: 2;
    width: auto;
    max-width: 100%;
    max-height: min(74vh, 640px);
    object-fit: contain;
    animation: float 6s var(--ease) infinite;
    will-change: transform;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .preview {
    padding-block: clamp(0.5rem, 0.3rem + 0.8vw, 1.25rem) clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .preview-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 0.8rem + 1.5vw, 2.25rem);
  }
  .preview-head .eyebrow {
    margin-bottom: 0.6rem;
  }
  .preview-head h2 {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .preview-count {
    flex: none;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .preview-count .pc-shown {
    color: var(--ink);
    font-weight: 600;
  }

  .all-row {
    position: relative;
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .all-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.03em;
    transition: gap 0.35s var(--ease);
  }
  .all-link:hover {
    gap: 1.2rem;
  }
  .all-link .arrow {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .landing {
      min-height: 0;
      padding-block: clamp(2.5rem, 2rem + 4vw, 5rem);
    }
    .landing-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
      justify-items: center;
    }
    .intro {
      order: 1;
    }
    .mascota {
      order: 0;
      margin-left: 0;
    }
    .tag {
      margin-inline: auto;
    }
    .mascota img {
      max-height: 40vh;
    }
  }
</style>

<script>
  const el = document.getElementById('mascota');
  const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (el && !mq.matches && !window.matchMedia('(hover: none)').matches) {
    let raf = 0;
    window.addEventListener('mousemove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const dx = (e.clientX / window.innerWidth - 0.5) * 14;
        const dy = (e.clientY / window.innerHeight - 0.5) * 10;
        el.style.setProperty('transform', `translate(${dx}px, ${dy}px)`);
      });
    });
  }
</script>
