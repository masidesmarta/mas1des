---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ProjectIndex from '../ProjectIndex.astro';
import heroImg from '../../assets/hero-panel14.webp';
import { useTranslations, type Lang } from '../../i18n/ui';
import { localeUrl, projectsFor } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all = projectsFor(await getCollection('proyectos'), lang);
const destacados = all.filter((p) => p.entry.data.destacado);
const preview = (destacados.length >= 4 ? destacados : all).slice(0, 5);
const total = all.length;
---

<Layout lang={lang} title={`Portfolio — Marta Masides`} description={t('meta.portfolioDesc')}>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="hero-kicker">{t('hero.kicker')}</p>
        <h1 class="hero-name">Marta<br />Masides<span class="hero-dot">.</span></h1>
        <p class="hero-tag">{t('hero.tagline')}</p>
        <a href={localeUrl(lang, '/proyectos')} class="hero-cta">
          <span>{t('hero.cta')}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="hero-media" data-reveal>
        <Image
          src={heroImg}
          alt={t('hero.imageAlt')}
          widths={[600, 1000, 1400, 1800]}
          sizes="(max-width: 820px) 100vw, 56vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="preview">
    <div class="wrap preview-head" data-reveal>
      <div>
        <p class="eyebrow">{t('home.kicker')} · {total} {t('proyectos.count')}</p>
        <h2 class="dot-title">{t('home.proyectos')}</h2>
      </div>
      <span class="preview-count">
        <span class="pc-shown">{preview.length}</span> {t('home.de')} {total}
      </span>
    </div>

    <div class="wrap">
      <ProjectIndex items={preview} lang={lang} />
    </div>

    <div class="wrap all-row" data-reveal>
      <a href={localeUrl(lang, '/proyectos')} class="all-link">
        {t('home.vertodos')} <span class="arrow">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--red);
    color: #fff;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.12fr;
    align-items: stretch;
    min-height: calc(88svh - 72px);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 3vw, 4rem) clamp(1.5rem, 3vw, 3.5rem) clamp(2rem, 3vw, 4rem)
      var(--gutter);
  }
  .hero-kicker {
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--paper); /* crema sobre rojo — cálido y cohesivo con el sitio (pasa AA) */
    margin-bottom: 1.6rem;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 1.4rem + 9vw, 9.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.005em;
    color: var(--paper);
  }
  .hero-dot {
    color: var(--paper);
  }
  .hero-tag {
    margin-top: 1.7rem;
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 24ch;
    color: var(--paper);
    font-weight: 500;
  }
  .hero-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.5rem;
    padding: 0.9rem 1.6rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    font-size: var(--step-0);
    font-weight: 500;
    transition:
      background 0.35s var(--ease),
      gap 0.35s var(--ease);
  }
  .hero-cta .arrow {
    transition: transform 0.35s var(--ease);
  }
  .hero-cta:hover {
    background: #000;
  }
  .hero-cta:hover .arrow {
    transform: translateX(5px);
  }
  .hero-cta:hover .arrow {
    transform: translateX(3px);
  }

  .hero-media {
    position: relative;
    min-height: 300px;
    background: var(--red-deep);
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview {
    padding-block: clamp(2rem, 1.2rem + 2.5vw, 3.5rem) clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .preview-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 0.8rem + 1.5vw, 2.25rem);
  }
  .preview-head .eyebrow {
    margin-bottom: 0.6rem;
  }
  .preview-head h2 {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .preview-count {
    flex: none;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .preview-count .pc-shown {
    color: var(--ink);
    font-weight: 600;
  }

  .all-row {
    position: relative;
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .all-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .all-link .arrow {
    color: var(--accent);
    transition: transform 0.35s var(--ease);
  }
  /* Desliza la flecha con transform (no gap) para no reflujar ni partir línea */
  .all-link:hover .arrow {
    transform: translateX(0.55rem);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-copy {
      order: 0;
      padding: clamp(2.5rem, 2rem + 5vw, 4rem) var(--gutter);
    }
    .hero-media {
      order: 1;
      min-height: clamp(300px, 52svh, 520px);
    }
    .hero-name {
      font-size: clamp(3.2rem, 2rem + 12vw, 6rem);
    }
  }
</style>
