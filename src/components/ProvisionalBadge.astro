---
// Cinta "provisional" sobre imágenes que aún son recortes del PDF.
// Se muestra solo cuando el proyecto tiene provisional: true.
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  show?: boolean;
  lang?: Lang;
}
const { show = false, lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

{
  show && (
    <span class="prov" title={t('prov.title')}>
      <span class="dot" /> {t('prov.label')}
    </span>
  )
}

<style>
  .prov {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.32em 0.62em;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    color: var(--ink-soft);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .dot {
    width: 0.46em;
    height: 0.46em;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
