---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const nav = [
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/estudio', label: 'Estudio' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Inicio — Marta Masides">
      Marta&nbsp;Masides<span class="brand-sub">arquitectura</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', 'link-underline', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 1rem;
  }
  .brand {
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .brand-sub {
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .nav {
    display: flex;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    align-items: center;
  }
  .nav-link {
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .nav-link.active {
    color: var(--ink);
  }

  /* Mobile */
  .nav-toggle,
  .burger {
    display: none;
  }
  @media (max-width: 720px) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      cursor: pointer;
      z-index: 60;
    }
    .burger span {
      height: 2px;
      width: 24px;
      background: var(--ink);
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .nav {
      position: fixed;
      inset: 68px 0 auto 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      padding: var(--gutter);
      transform: translateY(-120%);
      transition: transform 0.35s ease;
    }
    .nav-link {
      font-size: var(--step-1);
      padding-block: 0.6rem;
    }
    .nav-toggle:checked ~ .nav {
      transform: translateY(0);
    }
    .nav-toggle:checked ~ .burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
