---
import { useTranslations, type Lang } from '../i18n/ui';
import { localeUrl, switchLocalePath } from '../i18n/utils';

interface Props {
  transparent?: boolean;
  lang: Lang;
}
const { transparent = false, lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const { pathname } = Astro.url;
const isActive = (href: string) => {
  const full = localeUrl(lang, href);
  return href === '/' ? pathname === full : pathname.startsWith(full);
};

const nav = [
  { href: '/proyectos', key: 'nav.proyectos' as const },
  { href: '/estudio', key: 'nav.estudio' as const },
  { href: '/contacto', key: 'nav.contacto' as const },
];
---

<header class:list={['site-header', { transparent }]} data-header>
  <div class="wrap bar">
    <a href={localeUrl(lang, '/')} class="brand" aria-label={t('nav.inicio')}>
      Marta Masides<span class="brand-dot">.</span>
    </a>

    <div class="bar-right">
      <div class="lang-switch" aria-label="Idioma / Language">
        <a
          href={switchLocalePath(path, 'es')}
          class:list={['lang', { active: lang === 'es' }]}
          hreflang="es"
          aria-current={lang === 'es' ? 'true' : undefined}>ES</a
        >
        <span class="sep" aria-hidden="true">/</span>
        <a
          href={switchLocalePath(path, 'en')}
          class:list={['lang', { active: lang === 'en' }]}
          hreflang="en"
          aria-current={lang === 'en' ? 'true' : undefined}>EN</a
        >
      </div>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
      <label for="nav-toggle" class="burger" aria-label={t('nav.abrir')}>
        <span></span><span></span><span></span>
      </label>

      <nav class="nav" aria-label={t('nav.principal')}>
        <div class="nav-links">
          {
            nav.map((item) => (
              <a
                href={localeUrl(lang, item.href)}
                class:list={['nav-link', { active: isActive(item.href) }]}
              >
                {t(item.key)}
              </a>
            ))
          }
        </div>
        <div class="nav-foot">
          <span class="nav-foot-label">{t('nav.footContacto')}</span>
          <a href="mailto:masidesmarta@gmail.com">masidesmarta@gmail.com</a>
          <a href="https://instagram.com/mas1des" target="_blank" rel="noopener">
            Instagram · @mas1des
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    opacity: 1;
    transition: opacity 0.4s var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .site-header.transparent {
    position: fixed;
    inset: 0 0 auto 0;
    color: #fff;
  }
  .site-header.transparent::before {
    opacity: 0;
  }
  .site-header.transparent.is-scrolled {
    color: var(--ink);
  }
  .site-header.transparent.is-scrolled::before {
    opacity: 1;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 1rem;
  }
  .brand {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    position: relative;
    z-index: 130;
  }
  .brand-dot {
    color: var(--accent);
  }
  .bar-right {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.4rem);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    font-weight: 500;
    z-index: 130;
    order: 2; /* desktop: a la derecha de los enlaces del nav */
  }
  .lang-switch .lang {
    color: currentColor;
    opacity: 0.55;
    transition: opacity 0.25s var(--ease);
  }
  .lang-switch .lang:hover {
    opacity: 0.9;
  }
  .lang-switch .lang.active {
    opacity: 1;
    color: var(--accent);
  }
  .lang-switch .sep {
    opacity: 0.35;
  }

  .nav {
    display: flex;
    align-items: center;
  }
  .nav-links {
    display: flex;
    gap: clamp(1.4rem, 3vw, 2.8rem);
    align-items: center;
  }
  .nav-foot {
    display: none;
  }
  .nav-link {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    color: currentColor;
    opacity: 0.7;
    transition:
      opacity 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .nav-link:hover {
    opacity: 1;
  }
  .nav-link.active {
    opacity: 1;
    color: var(--accent);
  }

  .nav-toggle,
  .burger {
    display: none;
  }

  @media (max-width: 760px) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      margin-right: -8px;
      cursor: pointer;
      z-index: 130;
    }
    .burger span {
      height: 2px;
      width: 26px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.35s var(--ease),
        opacity 0.2s var(--ease);
    }

    .nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: stretch;
      padding: 96px var(--gutter) calc(var(--gutter) + 6px);
      background: var(--paper);
      color: var(--ink);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8%);
      transition:
        transform 0.5s var(--ease),
        opacity 0.35s var(--ease),
        visibility 0s linear 0.5s;
    }
    .nav-links {
      flex: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.1rem;
    }
    .nav-link {
      font-size: var(--step-3);
      letter-spacing: -0.02em;
      text-transform: none;
      opacity: 0;
      transform: translateY(10px);
      padding-block: 0.35rem;
      transition:
        opacity 0.4s var(--ease),
        transform 0.4s var(--ease),
        color 0.25s var(--ease);
    }
    .nav-foot {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      border-top: 1px solid var(--line);
      padding-top: 1.3rem;
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity 0.4s var(--ease) 0.15s,
        transform 0.4s var(--ease) 0.15s;
    }
    .nav-foot-label {
      font-size: var(--step--1);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.2rem;
    }
    .nav-foot a {
      font-size: var(--step-0);
      color: var(--ink-soft);
    }

    .nav-toggle:checked ~ .nav {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      transition:
        transform 0.5s var(--ease),
        opacity 0.35s var(--ease),
        visibility 0s;
    }
    .nav-toggle:checked ~ .nav .nav-link,
    .nav-toggle:checked ~ .nav .nav-foot {
      opacity: 1;
      transform: none;
    }
    .nav-toggle:checked ~ .nav .nav-link:nth-child(1) {
      transition-delay: 0.12s;
    }
    .nav-toggle:checked ~ .nav .nav-link:nth-child(2) {
      transition-delay: 0.18s;
    }
    .nav-toggle:checked ~ .nav .nav-link:nth-child(3) {
      transition-delay: 0.24s;
    }

    .nav-toggle:checked ~ .burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
    .nav-toggle:checked ~ .burger {
      color: var(--ink);
    }
  }
</style>
