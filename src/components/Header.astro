---
interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const nav = [
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/estudio', label: 'Estudio' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header
  class:list={['site-header', { transparent }]}
  data-header
>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Inicio — Marta Masides">
      Marta Masides<span class="brand-dot">.</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="burger" aria-label="Abrir menú">
      <span></span><span></span>
    </label>

    <nav class="nav" aria-label="Principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      color 0.4s var(--ease);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }

  /* Transparent over hero (home): white text, no bg until scrolled */
  .site-header.transparent {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    backdrop-filter: none;
    color: #fff;
  }
  .site-header.transparent.is-scrolled {
    position: fixed;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    color: var(--ink);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 1rem;
  }
  .brand {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .brand-dot {
    color: var(--accent);
  }
  .nav {
    display: flex;
    gap: clamp(1.4rem, 3vw, 2.8rem);
    align-items: center;
  }
  .nav-link {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    color: currentColor;
    opacity: 0.7;
    transition: opacity 0.25s var(--ease);
  }
  .nav-link:hover,
  .nav-link.active {
    opacity: 1;
  }

  .nav-toggle,
  .burger {
    display: none;
  }

  @media (max-width: 760px) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 40px;
      height: 40px;
      cursor: pointer;
      z-index: 120;
    }
    .burger span {
      height: 1.5px;
      width: 26px;
      background: currentColor;
      transition:
        transform 0.35s var(--ease),
        opacity 0.35s var(--ease);
    }
    .nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.5rem;
      padding: var(--gutter);
      background: var(--paper);
      color: var(--ink);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-100%);
      transition:
        transform 0.45s var(--ease),
        opacity 0.3s var(--ease),
        visibility 0s linear 0.45s;
    }
    .nav-link {
      font-size: var(--step-3);
      letter-spacing: -0.02em;
      text-transform: none;
      opacity: 1;
      padding-block: 0.4rem;
    }
    .nav-toggle:checked ~ .nav {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      transition:
        transform 0.45s var(--ease),
        opacity 0.3s var(--ease),
        visibility 0s;
    }
    .nav-toggle:checked ~ .burger span:nth-child(1) {
      transform: translateY(3.75px) rotate(45deg);
    }
    .nav-toggle:checked ~ .burger span:nth-child(2) {
      transform: translateY(-3.75px) rotate(-45deg);
    }
    /* keep burger visible/dark when menu open even on transparent header */
    .nav-toggle:checked ~ .burger {
      color: var(--ink);
      position: fixed;
      top: 16px;
      right: var(--gutter);
    }
  }
</style>
