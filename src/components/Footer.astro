---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">Marta Masides</p>
      <p class="muted">Arquitectura · Interiorismo</p>
    </div>
    <nav class="cols" aria-label="Pie">
      <a href="/proyectos" class="link-underline">Proyectos</a>
      <a href="/estudio" class="link-underline">Estudio</a>
      <a href="/contacto" class="link-underline">Contacto</a>
    </nav>
    <div class="cols">
      <a href="mailto:masidesmarta@gmail.com" class="link-underline"
        >masidesmarta@gmail.com</a
      >
      <a
        href="https://instagram.com/mas1des"
        class="link-underline"
        target="_blank"
        rel="noopener">@mas1des</a
      >
    </div>
  </div>
  <div class="wrap legal">
    <span class="muted">© {year} Marta Masides. Todos los derechos reservados.</span>
    <span class="credit muted">
      Diseño y desarrollo ·{' '}
      <a href="https://ebecerra.es" target="_blank" rel="noopener" class="credit-link link-underline">ebecerra.es</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) 1.5rem;
    margin-top: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 2rem;
  }
  .name {
    font-size: var(--step-1);
    margin: 0 0 0.2rem;
  }
  .muted {
    color: var(--muted);
    margin: 0;
  }
  .cols {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .legal {
    margin-top: 2.5rem;
    font-size: var(--step--1);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .credit-link {
    color: var(--ink-soft);
  }
  .credit-link:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
