---
import { useTranslations, type Lang } from '../i18n/ui';
import { localeUrl } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">Marta Masides</p>
      <p class="muted">{t('foot.rol')}</p>
    </div>
    {/* Etiqueta distinta a la del nav del header (landmarks duplicados).
        Enlaces a las versiones web: el footer vive dentro del navegador. */}
    <nav class="cols" aria-label={lang === 'en' ? 'Footer' : 'Pie de página'}>
      <a href={localeUrl(lang, '/proyectos')} class="link-underline">{t('nav.proyectos')}</a>
      <a href={localeUrl(lang, '/portfolio/estudio')} class="link-underline">{t('nav.estudio')}</a>
      <a href={localeUrl(lang, '/portfolio/contacto')} class="link-underline">{t('nav.contacto')}</a>
    </nav>
    <div class="cols">
      <a href="mailto:masidesmarta@gmail.com" class="link-underline"
        >masidesmarta@gmail.com</a
      >
      <a
        href="https://instagram.com/mas1des"
        class="link-underline"
        target="_blank"
        rel="noopener">@mas1des</a
      >
    </div>
  </div>
  <div class="wrap legal">
    <span class="muted">© {year} Marta Masides. {t('foot.rights')}</span>
    <span class="credit muted">
      {t('foot.credit')} ·{' '}
      <a href="https://ebecerra.es" target="_blank" rel="noopener" class="credit-link link-underline">ebecerra.es</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) 1.5rem;
    margin-top: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 2rem;
  }
  .name {
    font-size: var(--step-1);
    margin: 0 0 0.2rem;
  }
  .muted {
    color: var(--muted);
    margin: 0;
  }
  .cols {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .legal {
    margin-top: 2.5rem;
    font-size: var(--step--1);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .credit-link {
    color: var(--ink-soft);
  }
  .credit-link:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
