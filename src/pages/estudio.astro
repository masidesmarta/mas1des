---
import Layout from '../layouts/Layout.astro';

const experiencia = [
  {
    puesto: 'Arquitecta en prácticas',
    lugar: 'Estudio Eduardo Navadijos',
    fechas: '2025 — 2026',
  },
  {
    puesto: 'Arquitecta en prácticas',
    lugar: 'CumuloLimbo — Arquitectura e Interiorismo',
    fechas: '2023 — 2024',
  },
  {
    puesto: 'Arquitecta en prácticas',
    lugar: 'ZOOCO — Arquitectura e Interiorismo',
    fechas: 'Junio — Julio 2023',
  },
];

const formacion = [
  {
    titulo: 'Máster Habilitante en Arquitectura (ETSAM)',
    lugar: 'Universidad Politécnica de Madrid',
    fechas: '2025 — 2026',
  },
  {
    titulo: 'Grado en Estudios de Arquitectura',
    lugar: 'Escuela de Arquitectura de Alcalá de Henares',
    fechas: '2019 — 2025',
  },
  {
    titulo: 'Estancia — Escuela de Arquitectura de A Coruña (UDC)',
    lugar: 'Universidade da Coruña',
    fechas: '2021 — 2022',
  },
  {
    titulo: 'Máster en BIM I y II',
    lugar: 'Escuela 24 Studio Lab',
    fechas: '2025',
  },
];

const destrezas = [
  { grupo: 'Edición', items: ['Photoshop', 'Illustrator', 'InDesign'] },
  { grupo: 'Elaboración de planos', items: ['Revit', 'AutoCAD', 'Rhinoceros'] },
  { grupo: 'Renderización', items: ['Lumion', 'Enscape'] },
];
---

<Layout
  title="Estudio — Marta Masides"
  description="Marta Masides, arquitecta por la ETSAM. Experiencia, formación y forma de trabajar."
>
  <section class="head wrap">
    <p class="eyebrow">Estudio</p>
    <h1 class="dot-title">Marta Masides</h1>
    <p class="lead">
      Arquitecta por la Escuela Técnica Superior de Arquitectura de Madrid
      (ETSAM). Diseño espacios atenta a la luz, la materia y el uso real de
      cada lugar.
    </p>
  </section>

  <section class="section wrap bio">
    <p>
      A lo largo de mi paso por distintos estudios de arquitectura he
      participado en la realización de planos de instalaciones y construcción,
      así como en la elaboración de renders, dibujos y maquetación para
      concursos. También he colaborado en la postproducción fotográfica y en la
      difusión de proyectos en revistas y plataformas especializadas.
    </p>
    <p>
      He complementado mi formación como arquitecta con un Máster en BIM (BIM I
      y II), desarrollando proyectos con herramientas como Revit y consolidando
      una base técnica que sigo ampliando en el entorno profesional. En esta
      selección de proyectos muestro mi recorrido académico y profesional, mis
      intereses y mi manera de entender la arquitectura.
    </p>
  </section>

  <hr class="hr wrap" />

  <section class="section wrap">
    <div class="cols">
      <div class="col">
        <h2>Experiencia</h2>
        <ul class="entries" role="list">
          {
            experiencia.map((e) => (
              <li>
                <span class="entry-fecha">{e.fechas}</span>
                <span class="entry-puesto">{e.puesto}</span>
                <span class="entry-lugar">{e.lugar}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2>Formación</h2>
        <ul class="entries" role="list">
          {
            formacion.map((f) => (
              <li>
                <span class="entry-fecha">{f.fechas}</span>
                <span class="entry-puesto">{f.titulo}</span>
                <span class="entry-lugar">{f.lugar}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <hr class="hr wrap" />

  <section class="section wrap">
    <h2>Herramientas</h2>
    <div class="destrezas">
      {
        destrezas.map((d) => (
          <div class="destreza">
            <p class="eyebrow">{d.grupo}</p>
            <ul role="list">
              {d.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="cta-row">
      <a href="/contacto" class="link-underline">Trabajemos juntos →</a>
    </div>
  </section>
</Layout>

<style>
  .head {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) 0;
  }
  .head h1 {
    margin: 1rem 0 1.2rem;
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.4;
    max-width: 48ch;
  }
  .bio {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
    color: var(--ink-soft);
  }
  .bio p {
    margin: 0 0 1.2rem;
    max-width: var(--measure);
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    max-width: 920px;
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .entries li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .entry-fecha {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .entry-puesto {
    color: var(--ink);
    font-weight: 500;
  }
  .entry-lugar {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .destrezas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    max-width: 820px;
  }
  .destreza ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--ink-soft);
  }
  .cta-row {
    margin-top: 3rem;
    font-size: var(--step-0);
  }
  @media (max-width: 640px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .destrezas {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
