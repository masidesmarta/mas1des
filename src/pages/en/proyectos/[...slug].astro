---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../../components/pages/ProjectDetail.astro';
import { projectsFor } from '../../../i18n/utils';

export async function getStaticPaths() {
  const list = projectsFor(await getCollection('proyectos'), 'en');
  return list.map((item, i) => ({
    params: { slug: item.slug },
    props: { entry: item.entry, next: list[(i + 1) % list.length] },
  }));
}

const { entry, next } = Astro.props;
---

<ProjectDetail lang="en" entry={entry} next={next} />
