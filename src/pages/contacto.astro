---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto — Marta Masides"
  description="Ponte en contacto con Marta Masides para tu proyecto de arquitectura o interiorismo."
>
  <section class="head wrap">
    <p class="eyebrow">Contacto</p>
    <h1>Hablemos de tu proyecto</h1>
    <p class="lead">
      Con base en Madrid y posibilidad de trabajo en remoto. Cuéntame qué
      tienes en mente.
    </p>
  </section>

  <section class="section wrap">
    <div class="channels">
      <a href="mailto:masidesmarta@gmail.com" class="channel">
        <span class="eyebrow">Email</span>
        <span class="value link-underline">masidesmarta@gmail.com</span>
      </a>
      <a
        href="https://instagram.com/mas1des"
        class="channel"
        target="_blank"
        rel="noopener"
      >
        <span class="eyebrow">Instagram</span>
        <span class="value link-underline">@mas1des</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .head {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) 0;
  }
  .head h1 {
    margin: 1rem 0 1.2rem;
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.4;
    max-width: 46ch;
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 1rem + 4vw, 4rem);
  }
  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .value {
    font-size: var(--step-1);
  }
</style>
