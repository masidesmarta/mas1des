---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const destacados = proyectos.filter((p) => p.data.destacado).slice(0, 4);
const lista = destacados.length ? destacados : proyectos.slice(0, 4);
---

<Layout>
  <!-- Hero -->
  <section class="hero wrap">
    <p class="eyebrow">Marta Masides · Arquitecta</p>
    <h1>
      Arquitectura atenta<br />a la luz y la materia.
    </h1>
    <p class="lead">
      Selección de proyectos académicos y profesionales: del paisaje minero de
      Riotinto a la visualización arquitectónica. Madrid, con posibilidad de
      trabajo en remoto.
    </p>
    <a href="/proyectos" class="cta link-underline">Ver proyectos →</a>
  </section>

  <hr class="hr" />

  <!-- Proyectos destacados -->
  <section class="section wrap">
    <header class="sec-head">
      <p class="eyebrow">Selección</p>
      <h2>Proyectos</h2>
    </header>

    {
      lista.length === 0 ? (
        <p class="empty">
          Todavía no hay proyectos cargados. Cuando lleguen las imágenes y los
          textos, cada uno aparecerá aquí.
        </p>
      ) : (
        <ul class="grid" role="list">
          {lista.map((p) => (
            <li class="card">
              <a href={`/proyectos/${p.id}`}>
                <div class="thumb">
                  {p.data.portada ? (
                    <Image
                      src={p.data.portada}
                      alt={p.data.titulo}
                      widths={[400, 800, 1200]}
                      sizes="(max-width: 720px) 100vw, 50vw"
                    />
                  ) : (
                    <div class="placeholder" aria-hidden="true" />
                  )}
                </div>
                <div class="meta">
                  <h3 class="card-title">{p.data.titulo}</h3>
                  <span class="card-info">
                    {[p.data.tipo, p.data.ubicacion, p.data.ano]
                      .filter(Boolean)
                      .join(' · ')}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <a href="/proyectos" class="all link-underline">Todos los proyectos →</a>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(3.5rem, 2rem + 8vw, 9rem) clamp(2.5rem, 1.5rem + 5vw, 6rem);
    max-width: 1100px;
  }
  .hero h1 {
    margin: 1.2rem 0 1.5rem;
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 42ch;
    line-height: 1.4;
  }
  .cta {
    display: inline-block;
    margin-top: 2rem;
    font-size: var(--step-0);
  }
  .sec-head {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-soft);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .card a:hover .thumb img {
    transform: scale(1.03);
  }
  .placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      var(--paper-soft),
      var(--paper-soft) 14px,
      var(--line) 14px,
      var(--line) 15px
    );
  }
  .meta {
    padding-top: 0.9rem;
  }
  .card-title {
    font-size: var(--step-1);
    margin-bottom: 0.2rem;
  }
  .card-info {
    color: var(--muted);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }
  .all {
    display: inline-block;
    margin-top: 3rem;
  }
  .empty {
    color: var(--muted);
    max-width: var(--measure);
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
