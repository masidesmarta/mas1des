---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProvisionalBadge from '../components/ProvisionalBadge.astro';

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const destacados = proyectos.filter((p) => p.data.destacado);
const preview = (destacados.length >= 4 ? destacados : proyectos).slice(0, 5);
---

<Layout>
  <!-- LANDING -->
  <section class="landing">
    <div class="wrap landing-inner">
      <div class="intro" data-reveal>
        <p class="eyebrow">Arquitecta · Madrid</p>
        <h1 class="name">Marta<br />Masides<span class="dot">.</span></h1>
        <p class="tag">
          Arquitectura atenta a la luz, la materia y el uso real de cada lugar.
        </p>
        <a href="/proyectos" class="cta">
          <span>Ver proyectos</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mascota" data-reveal>
        <img
          src="/mascota.png"
          alt="Ilustración de Marta asomando tras un libro abierto que dice «Portfolio»"
          width="900"
          height="875"
          fetchpriority="high"
        />
        <span class="ground" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- PREVIEW DE PROYECTOS -->
  <section class="preview">
    <div class="wrap preview-head" data-reveal>
      <p class="eyebrow">Selección</p>
      <h2>Proyectos</h2>
    </div>

    <ul class="proj-list wrap" role="list">
      {
        preview.map((p, i) => (
          <li class="proj-row" data-reveal>
            <a href={`/proyectos/${p.id}`}>
              <span class="pr-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="pr-title">{p.data.titulo}</span>
              <span class="pr-meta">
                {[p.data.tipo, p.data.ubicacion].filter(Boolean).join(' · ')}
              </span>
              <span class="pr-arrow" aria-hidden="true">→</span>
              <span class="pr-thumb">
                <ProvisionalBadge show={p.data.provisional} />
                {p.data.portada && (
                  <Image
                    src={p.data.portada}
                    alt={p.data.titulo}
                    widths={[300, 500]}
                    sizes="300px"
                  />
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="wrap all-row" data-reveal>
      <a href="/proyectos" class="all-link">
        Ver todos los proyectos <span class="arrow">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* LANDING */
  .landing {
    position: relative;
    min-height: calc(100svh - 72px);
    display: flex;
    align-items: center;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem);
    overflow: hidden;
  }
  .landing-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 4vw, 5rem);
    width: 100%;
  }
  .eyebrow {
    margin-bottom: 1.4rem;
  }
  .name {
    font-size: var(--step-5);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }
  .dot {
    color: var(--accent);
  }
  .tag {
    margin-top: 1.6rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 32ch;
    line-height: 1.4;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.4rem;
    padding: 0.85rem 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    font-size: var(--step-0);
    font-weight: 500;
    transition:
      background 0.35s var(--ease),
      gap 0.35s var(--ease);
  }
  .cta .arrow {
    transition: transform 0.35s var(--ease);
  }
  .cta:hover {
    background: var(--accent);
    gap: 1.1rem;
  }
  .cta:hover .arrow {
    transform: translateX(3px);
  }

  .mascota {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .mascota img {
    position: relative;
    z-index: 2;
    width: auto;
    max-width: 100%;
    max-height: min(70vh, 600px);
    object-fit: contain;
  }
  .ground {
    position: absolute;
    bottom: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: min(78%, 460px);
    height: 1px;
    background: var(--line);
    z-index: 1;
  }
  /* PREVIEW */
  .preview {
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .preview-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: clamp(1.25rem, 0.8rem + 1.5vw, 2.25rem);
  }
  .preview-head h2 {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .proj-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proj-row {
    border-top: 1px solid var(--line);
  }
  .proj-row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .proj-row a {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1.2rem;
    padding: clamp(1rem, 0.6rem + 1.6vw, 1.9rem) 0.4rem;
    transition: padding-left 0.4s var(--ease);
  }
  .proj-row a:hover {
    padding-left: 1.2rem;
  }
  .pr-num {
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .pr-title {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 0.3s var(--ease);
  }
  .proj-row a:hover .pr-title {
    color: var(--accent);
  }
  .pr-meta {
    font-size: var(--step--1);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: right;
  }
  .pr-arrow {
    font-size: var(--step-1);
    color: var(--muted);
    transition:
      transform 0.35s var(--ease),
      color 0.3s var(--ease);
  }
  .proj-row a:hover .pr-arrow {
    transform: translateX(4px);
    color: var(--ink);
  }
  /* miniatura flotante en hover (desktop) */
  .pr-thumb {
    position: absolute;
    right: 12%;
    top: 50%;
    z-index: 6;
    width: 240px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(-50%) scale(0.94) rotate(-2deg);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s var(--ease);
    pointer-events: none;
  }
  .pr-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) {
    .proj-row a:hover .pr-thumb {
      opacity: 1;
      transform: translateY(-50%) scale(1) rotate(-2deg);
    }
  }

  .all-row {
    padding-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .all-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.03em;
    transition: gap 0.35s var(--ease);
  }
  .all-link:hover {
    gap: 1.2rem;
  }
  .all-link .arrow {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .landing {
      min-height: 0;
      padding-block: clamp(2.5rem, 2rem + 4vw, 5rem);
    }
    .landing-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
      justify-items: center;
    }
    .intro {
      order: 1;
    }
    .mascota {
      order: 0;
    }
    .tag {
      margin-inline: auto;
    }
    .mascota img {
      max-height: 42vh;
    }

    /* preview: filas apiladas con miniatura visible */
    .proj-row a {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: clamp(1rem, 0.8rem + 1.5vw, 1.5rem) 0;
    }
    .proj-row a:hover {
      padding-left: 0;
    }
    .pr-num {
      order: 1;
      text-align: left;
      margin-bottom: 0.3rem;
    }
    .pr-title {
      order: 2;
      font-size: var(--step-1);
      text-align: left;
      margin-bottom: 0.9rem;
    }
    .pr-thumb {
      order: 3;
      position: relative;
      inset: auto;
      width: 100%;
      aspect-ratio: 4 / 3;
      opacity: 1;
      transform: none;
      box-shadow: none;
      margin-bottom: 0.8rem;
    }
    .pr-meta {
      order: 4;
      text-align: left;
    }
    .pr-arrow {
      display: none;
    }
  }
</style>
