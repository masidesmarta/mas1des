---
/**
 * MODO LECTURA: el portfolio editorial (header, hero, listados, footer)
 * renderizado DENTRO de una ventana de Internet Explorer sobre el
 * escritorio. Render nativo (nada de iframes): estas rutas SSR son el
 * contenido indexable de verdad; el chrome del navegador es decoración.
 * En móvil la ventana va a pantalla completa, como el resto del OS.
 */
import OSLayout from './OSLayout.astro';
import Window from '../components/os/Window.astro';
import OSIcon from '../components/os/OSIcon.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeUrl } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Canonical hacia la vista principal (ver BaseHead). */
  canonicalPath?: string;
}

const {
  title = 'Marta Masides — Arquitecta',
  description,
  lang = 'es',
  canonicalPath,
} = Astro.props;
const t = useTranslations(lang);
// Barra de direcciones in-world (el dominio "bonito" de la ficción del OS).
const address = `www.mas1des.es${Astro.url.pathname}`;
---

<OSLayout
  lang={lang}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  window={{ title: `${title} — Internet Explorer`, icon: 'internet' }}
>
  <main id="main" class="window-stage">
    <Window
      lang={lang}
      title={`${title} — Internet Explorer`}
      icon="internet"
      closeHref={localeUrl(lang, '/')}
      size="max"
    >
      <div class="ie-toolbar" slot="toolbar">
        <button class="w2k-btn ie-btn" data-ie-back aria-label={t('os.atras')} disabled>
          <span aria-hidden="true">←</span>
        </button>
        <button class="w2k-btn ie-btn" data-ie-fwd aria-label={lang === 'en' ? 'Forward' : 'Adelante'} disabled>
          <span aria-hidden="true">→</span>
        </button>
        <a
          class="w2k-btn ie-btn"
          href={Astro.url.pathname}
          aria-label={lang === 'en' ? 'Reload' : 'Recargar'}
        >
          <span aria-hidden="true">⟳</span>
        </a>
        <span class="addr-label">{t('os.direccion')}:</span>
        <span class="addr bevel-down">
          <OSIcon name="internet" size={13} />
          {address}
        </span>
      </div>

      <div class="page">
        <Header lang={lang} />
        <div class="page-main">
          <slot />
        </div>
        <Footer lang={lang} />
      </div>
    </Window>
  </main>
</OSLayout>

<style>
  .ie-toolbar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    min-width: 0;
  }
  .ie-btn {
    width: 30px;
    height: 26px;
    font-size: 0.95rem;
    color: inherit;
    flex: none;
  }
  .ie-btn[disabled] {
    opacity: 0.45;
    cursor: default;
  }
  .addr-label {
    flex: none;
    opacity: 0.8;
    margin-left: 0.25rem;
  }
  .addr {
    flex: 1;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.55rem;
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 560px) {
    .addr-label {
      display: none;
    }
  }

  /* La "página web" dentro del navegador */
  .page {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
  }
  .page-main {
    flex: 1;
  }
</style>

<script>
  // Atrás/adelante del navegador in-world (history real). Los botones
  // nacen disabled y solo se activan con JS: sin JS el modo lectura
  // funciona igual (enlaces reales + recargar como <a>).
  function initIE() {
    const back = document.querySelector<HTMLButtonElement>('[data-ie-back]');
    const fwd = document.querySelector<HTMLButtonElement>('[data-ie-fwd]');
    if (!back || !fwd || back.dataset.ieInit) return;
    back.dataset.ieInit = '1';
    back.disabled = history.length <= 1;
    fwd.disabled = false;
    back.addEventListener('click', () => history.back());
    fwd.addEventListener('click', () => history.forward());
  }
  initIE();
  document.addEventListener('astro:page-load', initIE);

  // Estado del header editorial ("is-scrolled") y reveal-on-scroll,
  // referidos al scroll INTERNO de la ventana del navegador.
  function initReader() {
    const scroller = document.querySelector<HTMLElement>('.window-body');
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!scroller || scroller.dataset.readerInit) return;
    scroller.dataset.readerInit = '1';

    if (header) {
      const setHeader = () => header.classList.toggle('is-scrolled', scroller.scrollTop > 40);
      setHeader();
      scroller.addEventListener('scroll', setHeader, { passive: true });
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }
  initReader();
  document.addEventListener('astro:page-load', initReader);
</script>
