---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  transparentHeader?: boolean;
  lang?: Lang;
}

const { title, description, transparentHeader = false, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <BaseHead title={title} description={description} lang={lang} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <Header transparent={transparentHeader} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.6rem 1rem;
        z-index: 200;
      }
      .skip:focus {
        left: 0;
      }
    </style>

    <script>
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Header state on scroll
      const header = document.querySelector('[data-header]');
      const setHeader = () =>
        header && header.classList.toggle('is-scrolled', window.scrollY > 40);

      // Parallax leve de portadas
      const parEls = Array.from(document.querySelectorAll('[data-parallax]'));
      let ticking = false;
      const updateParallax = () => {
        const vh = window.innerHeight || 1;
        for (const el of parEls) {
          const r = el.getBoundingClientRect();
          const p = (r.top + r.height / 2 - vh / 2) / vh; // -0.5..0.5
          const amp = parseFloat(el.dataset.parallax) || 8; // en %
          el.style.setProperty('--py', (-p * amp).toFixed(2) + '%');
        }
        ticking = false;
      };
      const onScroll = () => {
        setHeader();
        if (!reduce && parEls.length && !ticking) {
          ticking = true;
          requestAnimationFrame(updateParallax);
        }
      };
      setHeader();
      if (!reduce) updateParallax();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      // Smooth scroll (Lenis) — solo si no hay reduce-motion
      if (!reduce) {
        const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
        const raf = (t) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
