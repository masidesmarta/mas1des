---
/**
 * Layout del "modo OS": wallpaper (imagen de un proyecto de Marta),
 * barra del sistema y el hueco donde cada ruta pinta su escritorio
 * o su ventana. El <head> SEO es el mismo del sitio (BaseHead).
 */
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Taskbar from '../components/os/Taskbar.astro';
import DesktopIcons from '../components/os/DesktopIcons.astro';
import type { Lang } from '../i18n/ui';
import wallpaperSrc from '../assets/hero-panel14.webp';
// Desktop: encuadre elegido por Enrique del render original de Riotinto
// (gal-01, 1800px): la carpa con el hueco, los haces de luz y la gente.
// Recorte pre-hecho con sharp (80,340,1400x773). El hero vertical, para móvil.
import wallpaperWide from '../assets/wallpaper-riotinto.webp';
import '../styles/os.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** Ver BaseHead: canonical para vistas alternativas. */
  canonicalPath?: string;
  /** Ventana abierta en esta ruta → botón en la taskbar. */
  window?: {
    title: string;
    icon: 'folder' | 'internet' | 'notepad' | 'mail' | 'image' | 'window';
  };
}
const { title, description, lang = 'es', canonicalPath, window: win } = Astro.props;

// Wallpaper optimizado: apaisado pre-encuadrado en desktop, vertical en móvil.
const wpLarge = await getImage({ src: wallpaperWide, width: 1920 });
const wpSmall = await getImage({ src: wallpaperSrc, width: 900 });
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      canonicalPath={canonicalPath}
      preloadDisplayFont={false}
    />
    {/* Navegación suave entre páginas del OS (abrir/cerrar ventanas sin recarga dura) */}
    <ClientRouter />
  </head>
  <body
    class="os os-cursor"
    style={`--wp-large:url(${wpLarge.src});--wp-small:url(${wpSmall.src})`}
  >
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    {/* Wallpaper: la obra ENTERA (contain) sobre un relleno de sí misma
        desenfocada — sin huecos y con el mínimo zoom posible. */}
    <div class="wallpaper" aria-hidden="true"></div>
    {/* Capa persistente: el escritorio sigue detrás de la ventana abierta */}
    <DesktopIcons lang={lang} />
    <slot />
    <Taskbar lang={lang} window={win} />

    <style is:global>
      :root {
        /* Espacio reservado por la barra del sistema (arriba en móvil,
           abajo en desktop). Las páginas del OS lo usan para no quedar
           tapadas por la barra. */
        --os-bar-h: 30px;
        --os-top: var(--os-bar-h);
        --os-bottom: 0px;
      }
      @media (min-width: 768px) {
        :root {
          --os-bar-h: 38px;
          --os-top: 0px;
          --os-bottom: var(--os-bar-h);
        }
      }

      body.os {
        font-family: var(--w2k-font);
        color: var(--w2k-text);
        min-height: 100svh;
        /* El OS no scrollea nunca: el scroll vive dentro de las ventanas y
           de la capa de iconos. Evita que el drag de ventanas haga crecer
           el documento (scrollbars fantasma). */
        overflow: hidden;
        height: 100svh;
        background-color: var(--w2k-desktop);
      }

      /* ---- Wallpaper en dos capas ----
         Móvil: la imagen vertical llena la pantalla (cover, encaja bien).
         Desktop: la obra ENTERA en contain + relleno desenfocado detrás
         (sin huecos, mínimo zoom). Velado encima para leer los iconos. */
      body.os .wallpaper {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }
      body.os .wallpaper::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(10, 17, 40, 0.55), rgba(10, 17, 40, 0.72)),
          var(--wp-small);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
      @media (min-width: 768px) {
        /* El render original apaisado: cover casi sin recorte. Velado con
           scrim lateral para que los iconos (izquierda) se lean. */
        body.os .wallpaper::after {
          background-image: linear-gradient(
              100deg,
              rgba(10, 17, 40, 0.6) 0%,
              rgba(10, 17, 40, 0.42) 34%,
              rgba(10, 17, 40, 0.34) 100%
            ),
            var(--wp-large);
          background-size: cover;
          background-position: center;
        }
      }

      body.os .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--w2k-select);
        color: var(--w2k-select-text);
        padding: 0.6rem 1rem;
        z-index: 300;
        font-family: var(--w2k-font);
      }
      body.os .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
